{
  "name": "panelwarp",
  "displayName": "Warp Terminal for VS Code",
  "description": "An unofficial fork of the open-source Warp terminal, running in a VS Code panel tab next to Terminal: blocks, command search, completions and BYOK AI. Not affiliated with Warp.",
  "version": "0.1.18",
  "publisher": "felixkrueckel",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/felkru/panelwarp"
  },
  "homepage": "https://github.com/felkru/panelwarp#readme",
  "bugs": {
    "url": "https://github.com/felkru/panelwarp/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "warp",
    "blocks",
    "shell",
    "ai"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "warp",
          "title": "Warp",
          "icon": "media/warp.svg"
        }
      ],
      "activitybar": [
        {
          "id": "warp-launcher",
          "title": "Warp",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "warp": [
        {
          "type": "webview",
          "id": "warp.view",
          "name": "Warp"
        },
        {
          "type": "webview",
          "id": "warp.panelLauncher",
          "name": "Warp",
          "when": "warp.inSideBar"
        }
      ],
      "warp-launcher": [
        {
          "type": "webview",
          "id": "warp.launcher",
          "name": "Warp",
          "when": "!warp.inSideBar"
        }
      ]
    },
    "commands": [
      {
        "command": "warp.commandPalette",
        "title": "Command Palette",
        "category": "Warp"
      },
      {
        "command": "warp.newTab",
        "title": "New Tab",
        "category": "Warp"
      },
      {
        "command": "warp.closeTab",
        "title": "Close Tab",
        "category": "Warp"
      },
      {
        "command": "warp.reopenClosedTab",
        "title": "Reopen Closed Tab",
        "category": "Warp"
      },
      {
        "command": "warp.nextTab",
        "title": "Next Tab",
        "category": "Warp"
      },
      {
        "command": "warp.previousTab",
        "title": "Previous Tab",
        "category": "Warp"
      },
      {
        "command": "warp.splitRight",
        "title": "Split Pane Right",
        "category": "Warp"
      },
      {
        "command": "warp.splitDown",
        "title": "Split Pane Down",
        "category": "Warp"
      },
      {
        "command": "warp.clearBlocks",
        "title": "Clear Blocks",
        "category": "Warp"
      },
      {
        "command": "warp.restart",
        "title": "Restart Panel",
        "category": "Warp"
      },
      {
        "command": "warp.openSettingsFile",
        "title": "Open Settings File",
        "category": "Warp"
      },
      {
        "command": "warp.openKeybindingsFile",
        "title": "Open Keybindings File",
        "category": "Warp"
      },
      {
        "command": "warp.setOpenRouterApiKey",
        "title": "Set OpenRouter API Key",
        "category": "Warp"
      },
      {
        "command": "warp.benchmarkCommandSearch",
        "title": "Benchmark AI Command Search",
        "category": "Warp"
      },
      {
        "command": "warp.show",
        "title": "Show Panel",
        "category": "Warp"
      },
      {
        "command": "warp.moveToSideBar",
        "title": "Move to Side Bar",
        "category": "Warp",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "warp.moveToPanel",
        "title": "Move to Bottom Panel",
        "category": "Warp",
        "icon": "$(layout-panel)"
      },
      {
        "command": "warp.splitClaudeTabs",
        "title": "Move Half of the Claude Code Tabs to a New Window",
        "category": "Warp",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "warp.saveClaudeWindow",
        "title": "Save Window (Claude Code Tabs) and Close It",
        "category": "Warp",
        "icon": "$(archive)"
      },
      {
        "command": "warp.reopenClaudeWindow",
        "title": "Reopen a Saved Window",
        "category": "Warp",
        "icon": "$(window)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warp.saveClaudeWindow",
          "when": "view == warp.view && warp.hasClaudeTabs",
          "group": "navigation@1"
        },
        {
          "command": "warp.reopenClaudeWindow",
          "when": "view == warp.view && warp.hasSavedWindows",
          "group": "navigation@2"
        },
        {
          "command": "warp.moveToPanel",
          "when": "view == warp.view && warp.inSideBar",
          "group": "navigation"
        },
        {
          "command": "warp.moveToSideBar",
          "when": "view == warp.view && !warp.inSideBar",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "warp.moveToPanel",
          "when": "warp.inSideBar"
        },
        {
          "command": "warp.moveToSideBar",
          "when": "!warp.inSideBar"
        }
      ],
      "editor/title": [
        {
          "command": "warp.saveClaudeWindow",
          "when": "activeWebviewPanelId == claudeVSCodePanel",
          "group": "navigation@90"
        },
        {
          "command": "warp.reopenClaudeWindow",
          "when": "activeWebviewPanelId == claudeVSCodePanel",
          "group": "navigation@91"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+`",
        "command": "warp.show",
        "when": "focusedView != 'warp.view'"
      },
      {
        "key": "ctrl+`",
        "command": "workbench.action.closePanel",
        "when": "focusedView == 'warp.view' && !warp.inSideBar"
      },
      {
        "key": "ctrl+`",
        "command": "workbench.action.closeSidebar",
        "when": "focusedView == 'warp.view' && warp.inSideBar"
      },
      {
        "key": "cmd+w",
        "command": "warp.closeTab",
        "when": "focusedView == 'warp.view' || panelFocus && activePanel == 'workbench.view.extension.warp' || sideBarFocus && activeViewlet == 'workbench.view.extension.warp-launcher'"
      },
      {
        "key": "cmd+shift+t",
        "command": "warp.reopenClosedTab",
        "when": "focusedView == 'warp.view' || panelFocus && activePanel == 'workbench.view.extension.warp' || sideBarFocus && activeViewlet == 'workbench.view.extension.warp-launcher'"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.0",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  }
}
