@@ -0,0 +1,513 @@
+//! The Agents panel for embedded (`remote_tty`) builds: recent coding-agent conversations
+//! (Claude Code, Codex, Gemini CLI) from anywhere on the machine, as listed by the embedding host
+//! (the VS Code panel). Hovering a row streams a short AI summary of it from the host; clicking
+//! opens it in the host (Claude Code) or resumes it in a new tab (agents that run in a terminal).
+
+use std::collections::HashMap;
+use std::ops::Range;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use chrono::{DateTime, Utc};
+use pathfinder_geometry::vector::vec2f;
+use warp_core::ui::theme::Fill as ThemeFill;
+use warp_util::path::user_friendly_path;
+use warpui::r#async::{SpawnedFutureHandle, Timer};
+use warpui::elements::{
+    Border, ChildAnchor, ConstrainedBox, Container, CornerRadius, CrossAxisAlignment,
+    DispatchEventResult, DropShadow, Element, EventHandler, Fill, Flex, Hoverable,
+    MainAxisAlignment, MainAxisSize, MouseInBehavior, MouseStateHandle, OffsetPositioning,
+    ParentAnchor, ParentElement, ParentOffsetBounds, Radius, ScrollStateHandle, Scrollable,
+    ScrollableElement, ScrollbarWidth, Shrinkable, Stack, Text, UniformList, UniformListState,
+};
+use warpui::platform::Cursor;
+use warpui::{AppContext, Entity, SingletonEntity, TypedActionView, View, ViewContext};
+
+use crate::ai::blocklist::CLAUDE_ORANGE;
+use crate::appearance::Appearance;
+use crate::terminal::cli_agent::GEMINI_BLUE;
+use crate::ui_components::icons::Icon;
+use crate::util::time_format::format_approx_duration_from_now_utc;
+use crate::workspace::header_toolbar_item::HeaderToolbarItemKind;
+use crate::workspace::tab_settings::TabSettings;
+
+/// How long the pointer has to rest on a row before its summary is requested, so sweeping over
+/// the list doesn't start a request per row.
+const SUMMARY_HOVER_DELAY: Duration = Duration::from_millis(450);
+const ICON_SIZE: f32 = 16.;
+const ICON_SPACING: f32 = 8.;
+const SUMMARY_MAX_WIDTH: f32 = 360.;
+
+#[derive(Clone, Debug, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct HostAgentConversation {
+    agent: String,
+    id: String,
+    title: String,
+    cwd: Option<String>,
+    /// Milliseconds since the epoch.
+    updated_at: f64,
+}
+
+impl HostAgentConversation {
+    /// Identifies this version of the conversation, so a summary is redone once it changes.
+    fn summary_key(&self) -> String {
+        format!("{}:{}:{}", self.agent, self.id, self.updated_at)
+    }
+
+    fn updated_at(&self) -> DateTime<Utc> {
+        DateTime::from_timestamp_millis(self.updated_at as i64).unwrap_or_default()
+    }
+}
+
+#[derive(Default)]
+struct Summary {
+    text: String,
+    error: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+pub enum AgentConversationsAction {
+    SetHoveredIndex(usize),
+    ClearHoveredIndex,
+    Open(usize),
+}
+
+pub enum AgentConversationsEvent {
+    /// Run this command in a new terminal tab (resumes an agent that runs in a terminal).
+    #[cfg_attr(not(target_family = "wasm"), allow(dead_code))]
+    RunInNewTab(String),
+}
+
+pub struct AgentConversationsView {
+    conversations: Vec<HostAgentConversation>,
+    loaded: bool,
+    row_states: Vec<MouseStateHandle>,
+    list_hover: MouseStateHandle,
+    list_state: UniformListState,
+    scroll_state: ScrollStateHandle,
+    hovered_index: Option<usize>,
+    summaries: HashMap<String, Summary>,
+    hover_delay: Option<SpawnedFutureHandle>,
+}
+
+impl AgentConversationsView {
+    pub fn new(_ctx: &mut ViewContext<Self>) -> Self {
+        Self {
+            conversations: Vec::new(),
+            loaded: false,
+            row_states: Vec::new(),
+            list_hover: Default::default(),
+            list_state: UniformListState::new(),
+            scroll_state: Arc::new(Mutex::new(Default::default())),
+            hovered_index: None,
+            summaries: HashMap::new(),
+            hover_delay: None,
+        }
+    }
+
+    /// Reloads the list from the host.
+    pub fn refresh(&mut self, ctx: &mut ViewContext<Self>) {
+        #[cfg(target_family = "wasm")]
+        ctx.spawn(
+            crate::platform::wasm::agent_conversations_from_host(),
+            |me, json, ctx| {
+                let conversations = json
+                    .and_then(|json| {
+                        serde_json::from_str::<Vec<HostAgentConversation>>(&json)
+                            .inspect_err(|err| log::warn!("Bad agent conversation list: {err}"))
+                            .ok()
+                    })
+                    .unwrap_or_default();
+                me.set_conversations(conversations, ctx);
+            },
+        );
+        #[cfg(not(target_family = "wasm"))]
+        self.set_conversations(Vec::new(), ctx);
+    }
+
+    fn set_conversations(
+        &mut self,
+        conversations: Vec<HostAgentConversation>,
+        ctx: &mut ViewContext<Self>,
+    ) {
+        self.row_states
+            .resize_with(conversations.len(), MouseStateHandle::default);
+        self.conversations = conversations;
+        self.loaded = true;
+        self.hovered_index = None;
+        self.cancel_hover_delay();
+        ctx.notify();
+    }
+
+    fn cancel_hover_delay(&mut self) {
+        if let Some(handle) = self.hover_delay.take() {
+            handle.abort();
+        }
+    }
+
+    fn set_hovered_index(&mut self, index: Option<usize>, ctx: &mut ViewContext<Self>) {
+        if self.hovered_index == index {
+            return;
+        }
+        self.hovered_index = index;
+        self.cancel_hover_delay();
+        if let Some(index) = index {
+            let already_requested = self.conversations.get(index).is_some_and(|conversation| {
+                self.summaries.contains_key(&conversation.summary_key())
+            });
+            if !already_requested {
+                self.hover_delay = Some(ctx.spawn(
+                    Timer::after(SUMMARY_HOVER_DELAY),
+                    move |me, _, ctx| {
+                        me.hover_delay = None;
+                        if me.hovered_index == Some(index) {
+                            me.request_summary(index, ctx);
+                        }
+                    },
+                ));
+            }
+        }
+        ctx.notify();
+    }
+
+    /// Starts streaming the summary of the conversation at `index` from the host. Finished and
+    /// in-progress summaries are kept, so each version of a conversation is summarized once.
+    fn request_summary(&mut self, index: usize, ctx: &mut ViewContext<Self>) {
+        let Some(conversation) = self.conversations.get(index) else {
+            return;
+        };
+        let key = conversation.summary_key();
+        if self.summaries.contains_key(&key) {
+            return;
+        }
+        self.summaries.insert(key.clone(), Summary::default());
+        ctx.notify();
+
+        #[cfg(target_family = "wasm")]
+        {
+            use crate::platform::wasm::AgentConversationSummaryUpdate;
+
+            let updates = crate::platform::wasm::agent_conversation_summary_from_host(
+                &conversation.agent,
+                &conversation.id,
+            );
+            let item_key = key.clone();
+            ctx.spawn_stream_local(
+                updates,
+                move |me, update, ctx| {
+                    let summary = me.summaries.entry(item_key.clone()).or_default();
+                    match update {
+                        AgentConversationSummaryUpdate::Text(text) => summary.text = text,
+                        AgentConversationSummaryUpdate::Error(error) => summary.error = Some(error),
+                    }
+                    ctx.notify();
+                },
+                move |me, ctx| {
+                    // Forget failed summaries so hovering again retries.
+                    if me
+                        .summaries
+                        .get(&key)
+                        .is_some_and(|summary| summary.error.is_some())
+                    {
+                        me.summaries.remove(&key);
+                    }
+                    ctx.notify();
+                },
+            );
+        }
+    }
+
+    fn open(&mut self, index: usize, ctx: &mut ViewContext<Self>) {
+        let Some(conversation) = self.conversations.get(index) else {
+            return;
+        };
+        #[cfg(target_family = "wasm")]
+        {
+            let agent = conversation.agent.clone();
+            let id = conversation.id.clone();
+            ctx.spawn(
+                async move {
+                    crate::platform::wasm::open_agent_conversation_in_host(&agent, &id).await
+                },
+                |_, command, ctx| {
+                    if let Some(command) = command.filter(|command| !command.is_empty()) {
+                        ctx.emit(AgentConversationsEvent::RunInNewTab(command));
+                    }
+                },
+            );
+        }
+        #[cfg(not(target_family = "wasm"))]
+        let _ = (conversation, ctx);
+    }
+}
+
+impl Entity for AgentConversationsView {
+    type Event = AgentConversationsEvent;
+}
+
+impl TypedActionView for AgentConversationsView {
+    type Action = AgentConversationsAction;
+
+    fn handle_action(&mut self, action: &Self::Action, ctx: &mut ViewContext<Self>) {
+        match action {
+            AgentConversationsAction::SetHoveredIndex(index) => {
+                self.set_hovered_index(Some(*index), ctx)
+            }
+            AgentConversationsAction::ClearHoveredIndex => self.set_hovered_index(None, ctx),
+            AgentConversationsAction::Open(index) => self.open(*index, ctx),
+        }
+    }
+}
+
+/// The agent's logo and the color to draw it in.
+fn agent_icon(agent: &str, appearance: &Appearance) -> (Icon, ThemeFill) {
+    let theme = appearance.theme();
+    match agent {
+        "claude" => (Icon::ClaudeLogo, ThemeFill::Solid(CLAUDE_ORANGE)),
+        "gemini" => (Icon::GeminiLogo, ThemeFill::Solid(GEMINI_BLUE)),
+        // OpenAI's brand color is black, which disappears on dark themes.
+        "codex" => (Icon::OpenAILogo, theme.main_text_color(theme.background())),
+        _ => (Icon::Stars, theme.sub_text_color(theme.background())),
+    }
+}
+
+fn render_summary_popover(summary: &Summary, appearance: &Appearance) -> Box<dyn Element> {
+    let theme = appearance.theme();
+    let (text, color) = match (&summary.error, summary.text.is_empty()) {
+        (Some(error), _) => (
+            format!("Couldn't summarize: {error}"),
+            theme.sub_text_color(theme.background()),
+        ),
+        (None, true) => (
+            "Summarizing…".to_owned(),
+            theme.sub_text_color(theme.background()),
+        ),
+        (None, false) => (
+            summary.text.clone(),
+            theme.main_text_color(theme.background()),
+        ),
+    };
+    Container::new(
+        ConstrainedBox::new(
+            Text::new(text, appearance.ui_font_family(), appearance.ui_font_size())
+                .with_color(color.into())
+                .finish(),
+        )
+        .with_max_width(SUMMARY_MAX_WIDTH)
+        .finish(),
+    )
+    .with_uniform_padding(10.)
+    .with_background(theme.surface_2())
+    .with_border(Border::all(1.).with_border_fill(theme.outline()))
+    .with_corner_radius(CornerRadius::with_all(Radius::Pixels(6.)))
+    .with_drop_shadow(DropShadow::default())
+    .finish()
+}
+
+fn render_row(
+    conversation: &HostAgentConversation,
+    index: usize,
+    is_hovered: bool,
+    summary: Option<&Summary>,
+    popover_opens_right: bool,
+    mouse_state: MouseStateHandle,
+    app: &AppContext,
+) -> Box<dyn Element> {
+    let appearance = Appearance::as_ref(app);
+    let theme = appearance.theme();
+    let font_family = appearance.ui_font_family();
+    let font_size = appearance.ui_font_size();
+
+    let (icon, icon_color) = agent_icon(&conversation.agent, appearance);
+    let icon = ConstrainedBox::new(icon.to_warpui_icon(icon_color).finish())
+        .with_width(ICON_SIZE)
+        .with_height(ICON_SIZE)
+        .finish();
+    let title = Text::new_inline(conversation.title.clone(), font_family, font_size + 1.)
+        .with_color(theme.main_text_color(theme.background()).into())
+        .finish();
+    let title_row = Flex::row()
+        .with_cross_axis_alignment(CrossAxisAlignment::Center)
+        .with_spacing(ICON_SPACING)
+        .with_child(icon)
+        .with_child(Shrinkable::new(1.0, title).finish())
+        .finish();
+
+    let home_dir = dirs::home_dir().and_then(|path| path.to_str().map(String::from));
+    let cwd = conversation
+        .cwd
+        .as_deref()
+        .map(|cwd| user_friendly_path(cwd, home_dir.as_deref()).into_owned())
+        .unwrap_or_default();
+    let sub_color = theme.sub_text_color(theme.background());
+    let bottom_row = Container::new(
+        Flex::row()
+            .with_main_axis_size(MainAxisSize::Max)
+            .with_main_axis_alignment(MainAxisAlignment::SpaceBetween)
+            .with_cross_axis_alignment(CrossAxisAlignment::End)
+            .with_child(
+                Shrinkable::new(
+                    1.0,
+                    Text::new_inline(cwd, font_family, font_size - 1.)
+                        .with_color(sub_color.into())
+                        .finish(),
+                )
+                .finish(),
+            )
+            .with_child(
+                Text::new_inline(
+                    format_approx_duration_from_now_utc(conversation.updated_at()),
+                    font_family,
+                    font_size - 2.,
+                )
+                .with_color(sub_color.into())
+                .finish(),
+            )
+            .finish(),
+    )
+    .with_padding_left(ICON_SIZE + ICON_SPACING)
+    .finish();
+
+    let content = Flex::column()
+        .with_cross_axis_alignment(CrossAxisAlignment::Stretch)
+        .with_spacing(2.)
+        .with_child(title_row)
+        .with_child(bottom_row)
+        .finish();
+
+    let popover = summary
+        .filter(|_| is_hovered)
+        .map(|summary| render_summary_popover(summary, appearance));
+    let row = Hoverable::new(mouse_state, move |_| {
+        let mut container = Container::new(content)
+            .with_horizontal_padding(12.)
+            .with_vertical_padding(6.);
+        if is_hovered {
+            container = container.with_background(theme.surface_overlay_1());
+        }
+        let mut stack = Stack::new().with_child(container.finish());
+        if let Some(popover) = popover {
+            let (parent_anchor, child_anchor, offset_x) = if popover_opens_right {
+                (ParentAnchor::MiddleRight, ChildAnchor::MiddleLeft, 4.)
+            } else {
+                (ParentAnchor::MiddleLeft, ChildAnchor::MiddleRight, -4.)
+            };
+            stack.add_positioned_overlay_child(
+                popover,
+                OffsetPositioning::offset_from_parent(
+                    vec2f(offset_x, 0.),
+                    ParentOffsetBounds::WindowByPosition,
+                    parent_anchor,
+                    child_anchor,
+                ),
+            );
+        }
+        stack.finish()
+    })
+    .with_cursor(Cursor::PointingHand)
+    .on_click(move |ctx, _, _| {
+        ctx.dispatch_typed_action(AgentConversationsAction::Open(index));
+    })
+    .finish();
+
+    EventHandler::new(row)
+        .on_mouse_in(
+            move |ctx, _, _| {
+                ctx.dispatch_typed_action(AgentConversationsAction::SetHoveredIndex(index));
+                DispatchEventResult::PropagateToParent
+            },
+            Some(MouseInBehavior {
+                fire_on_synthetic_events: false,
+                fire_when_covered: false,
+            }),
+        )
+        .finish()
+}
+
+impl View for AgentConversationsView {
+    fn ui_name() -> &'static str {
+        "AgentConversationsView"
+    }
+
+    fn render(&self, app: &AppContext) -> Box<dyn Element> {
+        let appearance = Appearance::as_ref(app);
+        let theme = appearance.theme();
+
+        if self.conversations.is_empty() {
+            let message = if self.loaded {
+                "No recent Claude Code, Codex or Gemini CLI conversations."
+            } else {
+                "Loading…"
+            };
+            return Container::new(
+                Text::new(
+                    message,
+                    appearance.ui_font_family(),
+                    appearance.ui_font_size(),
+                )
+                .with_color(theme.sub_text_color(theme.background()).into())
+                .finish(),
+            )
+            .with_horizontal_padding(12.)
+            .with_vertical_padding(8.)
+            .finish();
+        }
+
+        // Open the summary towards the middle of the window.
+        let popover_opens_right = TabSettings::as_ref(app)
+            .header_toolbar_chip_selection
+            .left_items()
+            .contains(&HeaderToolbarItemKind::ToolsPanel);
+        let rows: Vec<Box<dyn Element>> = self
+            .conversations
+            .iter()
+            .enumerate()
+            .map(|(index, conversation)| {
+                let is_hovered = self.hovered_index == Some(index);
+                render_row(
+                    conversation,
+                    index,
+                    is_hovered,
+                    self.summaries.get(&conversation.summary_key()),
+                    popover_opens_right,
+                    self.row_states[index].clone(),
+                    app,
+                )
+            })
+            .collect();
+        let rows = Arc::new(Mutex::new(rows.into_iter().map(Some).collect::<Vec<_>>()));
+        let list = UniformList::new(
+            self.list_state.clone(),
+            self.conversations.len(),
+            move |range: Range<usize>, _: &AppContext| {
+                let mut rows = rows.lock().expect("rows lock poisoned");
+                range
+                    .filter_map(|index| rows.get_mut(index).and_then(Option::take))
+                    .collect::<Vec<_>>()
+                    .into_iter()
+            },
+        )
+        .finish_scrollable();
+
+        let scrollable = Scrollable::vertical(
+            self.scroll_state.clone(),
+            list,
+            ScrollbarWidth::Auto,
+            theme.nonactive_ui_detail().into(),
+            theme.active_ui_detail().into(),
+            Fill::None,
+        )
+        .with_overlayed_scrollbar()
+        .finish();
+
+        Hoverable::new(self.list_hover.clone(), move |_| scrollable)
+            .on_hover(|is_hovered, ctx, _, _| {
+                if !is_hovered {
+                    ctx.dispatch_typed_action(AgentConversationsAction::ClearHoveredIndex);
+                }
+            })
+            .with_skip_synthetic_hover_out()
+            .finish()
+    }
+}
