+/// Lists recent coding-agent conversations (Claude Code, Codex, Gemini CLI) from anywhere on the
+/// machine via the host's `window.warpPanelAgentConversations()`, which resolves to a JSON array
+/// of `{agent, id, title, cwd, updatedAt}` (`updatedAt` in milliseconds since the epoch).
+/// Resolves to None if the host doesn't provide it or fails.
+pub async fn agent_conversations_from_host() -> Option<String> {
+    let promise = ffi::agent_conversations().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .ok()?
+        .as_string()
+}
+
+/// An update to a conversation summary streamed by the host.
+pub enum AgentConversationSummaryUpdate {
+    /// The summary so far (the whole text, not a delta).
+    Text(String),
+    Error(String),
+}
+
+/// Streams an AI summary of a coding-agent conversation from the host's
+/// `window.warpPanelAgentConversationSummary(agent, id, onText)`, which calls `onText` with the
+/// summary so far and resolves when it's complete (or rejects with an error message).
+pub fn agent_conversation_summary_from_host(
+    agent: &str,
+    id: &str,
+) -> futures::channel::mpsc::UnboundedReceiver<AgentConversationSummaryUpdate> {
+    use wasm_bindgen::closure::Closure;
+
+    let (tx, rx) = futures::channel::mpsc::unbounded();
+    let text_tx = tx.clone();
+    let on_text = Closure::<dyn FnMut(String)>::new(move |text: String| {
+        let _ = text_tx.unbounded_send(AgentConversationSummaryUpdate::Text(text));
+    });
+    match ffi::agent_conversation_summary(agent, id, on_text.as_ref().unchecked_ref()) {
+        Ok(promise) => wasm_bindgen_futures::spawn_local(async move {
+            if let Err(err) = wasm_bindgen_futures::JsFuture::from(promise).await {
+                let message = err
+                    .as_string()
+                    .unwrap_or_else(|| "summary failed".to_owned());
+                let _ = tx.unbounded_send(AgentConversationSummaryUpdate::Error(message));
+            }
+            // Dropping the callback and both senders ends the stream.
+            drop(on_text);
+        }),
+        Err(_) => {
+            let _ = tx.unbounded_send(AgentConversationSummaryUpdate::Error(
+                "not supported by the host".to_owned(),
+            ));
+        }
+    }
+    rx
+}
+
+/// Asks the host to open a coding-agent conversation. Claude Code conversations open in the host
+/// (VS Code: the Claude Code extension's editor tab) and this resolves to None; for agents that
+/// resume in a terminal it resolves to the command to run in a new Warp tab.
+pub async fn open_agent_conversation_in_host(agent: &str, id: &str) -> Option<String> {
+    let promise = ffi::open_agent_conversation(agent, id).ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .ok()?
+        .as_string()
+}
