+/// Asks the embedding host app to open its keybindings file, since the web build keeps
+/// keybindings in localStorage. Returns false if the host doesn't provide
+/// `window.warpPanelOpenKeybindingsFile`.
+pub fn open_keybindings_file_in_host() -> bool {
+    ffi::open_keybindings_file_in_host().is_ok()
+}
+
+/// Whether the host page defines `window[name]` as a function, for UI that only works with
+/// that hook.
+pub fn host_has_function(name: &str) -> bool {
+    js_sys::Reflect::get(&js_sys::global(), &JsValue::from_str(name))
+        .is_ok_and(|value| value.is_function())
+}
