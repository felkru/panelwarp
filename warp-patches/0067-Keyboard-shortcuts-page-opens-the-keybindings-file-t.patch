+/// Styled like the settings sidebar's "Open settings file" button, sized to its label.
+fn render_open_keybindings_file_button(
+    appearance: &Appearance,
+    mouse_state: MouseStateHandle,
+) -> Box<dyn Element> {
+    let theme = appearance.theme();
+    let text_fill = theme.nonactive_ui_text_color();
+    let text_color = text_fill.into_solid();
+    let border_color = theme.outline().into_solid();
+    let ui_font_family = appearance.ui_font_family();
+
+    let button = Hoverable::new(mouse_state, move |state| {
+        let icon = ConstrainedBox::new(Icon::Code2.to_warpui_icon(text_fill).finish())
+            .with_width(OPEN_KEYBINDINGS_FILE_ICON_SIZE)
+            .with_height(OPEN_KEYBINDINGS_FILE_ICON_SIZE)
+            .finish();
+        let label = Text::new_inline(
+            "Open keybindings file",
+            ui_font_family,
+            OPEN_KEYBINDINGS_FILE_FONT_SIZE,
+        )
+        .with_color(text_color)
+        .with_style(Properties {
+            weight: Weight::Semibold,
+            ..Default::default()
+        })
+        .finish();
+        let row = Flex::row()
+            .with_cross_axis_alignment(CrossAxisAlignment::Center)
+            .with_child(Container::new(icon).with_margin_right(4.).finish())
+            .with_child(label)
+            .finish();
+
+        let mut container = Container::new(row)
+            .with_horizontal_padding(12.)
+            .with_border(Border::all(1.).with_border_color(border_color))
+            .with_corner_radius(CornerRadius::with_all(Radius::Pixels(4.)));
+        if state.is_hovered() {
+            container = container.with_background_color(coloru_with_opacity(text_color, 10));
+        }
+
+        ConstrainedBox::new(container.finish())
+            .with_height(OPEN_KEYBINDINGS_FILE_BUTTON_HEIGHT)
+            .finish()
+    })
+    .with_cursor(Cursor::PointingHand)
+    .on_click(|ctx, _, _| ctx.dispatch_typed_action(KeybindingsViewAction::OpenKeybindingsFile))
+    .finish();
+    Container::new(button).with_margin_top(12.).finish()
+}
