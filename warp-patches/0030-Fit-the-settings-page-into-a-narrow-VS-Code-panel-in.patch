From 3a41f2216dabafec97392871ce1f74f1147af972 Mon Sep 17 00:00:00 2001
From: Felix Krueckel <hi@felkru.com>
Date: Thu, 8 Oct 2026 01:33:13 -0700
Subject: [PATCH 30/54] Fit the settings page into a narrow VS Code panel in
 embedded builds

In the panel (~780 px wide) the page's 520 px minimum width pushed every row
past the right edge behind a horizontal scrollbar. Embedded builds now let the
page shrink to 300 px and use a 180 px sidebar (their page names are short and
the footer has no Warp Agent button).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/settings_view/mod.rs           | 9 ++++++++-
 app/src/settings_view/settings_page.rs | 4 +++-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/app/src/settings_view/mod.rs b/app/src/settings_view/mod.rs
index bb414dd..3b8e765 100644
--- a/app/src/settings_view/mod.rs
+++ b/app/src/settings_view/mod.rs
@@ -154,12 +154,19 @@ const SIDEBAR_WIDTH_DEFAULT: f32 = 200.;
 /// with the designed 24px indent and 8px internal padding.
 const SIDEBAR_WIDTH_WITH_FOOTER: f32 = 248.;
 
+/// Sidebar width in embedded (`remote_tty`) builds.
+const SIDEBAR_WIDTH_EMBEDDED: f32 = 180.;
+
 /// Returns the sidebar width, widened only when the settings-file footer
 /// is enabled. This keeps the wider layout gated with the footer itself so
 /// Preview/Stable users don't see an unexplained 48px width bump before
 /// the feature ships.
 fn sidebar_width() -> f32 {
-    if FeatureFlag::SettingsFile.is_enabled() {
+    // Embedded builds have short page names and no Warp Agent button in the footer, and the VS
+    // Code panel needs the room for the page.
+    if cfg!(feature = "remote_tty") {
+        SIDEBAR_WIDTH_EMBEDDED
+    } else if FeatureFlag::SettingsFile.is_enabled() {
         SIDEBAR_WIDTH_WITH_FOOTER
     } else {
         SIDEBAR_WIDTH_DEFAULT
diff --git a/app/src/settings_view/settings_page.rs b/app/src/settings_view/settings_page.rs
index 3942bb7..69e492a 100644
--- a/app/src/settings_view/settings_page.rs
+++ b/app/src/settings_view/settings_page.rs
@@ -70,7 +70,9 @@ pub const SUBHEADER_FONT_SIZE: f32 = 16.;
 const ALTERNATING_LIST_CLOSE_BUTTON_DIAMETER: f32 = 20.0;
 const ALTERNATING_LIST_ITEM_PADDING: f32 = 8.0;
 const GREY_TEXT_OPACITY: u8 = 60;
-const MIN_PAGE_WIDTH: f32 = 520.;
+/// Embedded builds live in a short, narrow VS Code panel: let the page shrink to the panel instead
+/// of scrolling sideways.
+const MIN_PAGE_WIDTH: f32 = if cfg!(feature = "remote_tty") { 300. } else { 520. };
 const MAX_PAGE_WIDTH: f32 = 800.;
 const INFO_TOOLTIP_MAX_WIDTH: f32 = 320.;
 
