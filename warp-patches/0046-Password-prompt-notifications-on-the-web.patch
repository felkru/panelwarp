From 7be5aadc978bc1b204590a6c634c09283df1a99c Mon Sep 17 00:00:00 2001
From: Felix Krueckel <hi@felkru.com>
Date: Thu, 8 Oct 2026 15:52:37 -0700
Subject: [PATCH 46/52] Password prompt notifications on the web

The PTY host reports a likely password prompt (a "password_prompt" control message),
which the desktop poller detects from the PTY's termios; it goes through the same
on_possible_password_prompt hook. Also drops an import left unused by the file-link change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/terminal/remote_tty/event_loop.rs     | 16 +++++++++++----
 .../terminal/remote_tty/terminal_manager.rs   | 20 ++++++++++++++++++-
 app/src/terminal/view.rs                      |  2 +-
 app/src/terminal/view/link_detection.rs       |  1 -
 .../writeable_pty/terminal_surface.rs         |  5 +++--
 5 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/app/src/terminal/remote_tty/event_loop.rs b/app/src/terminal/remote_tty/event_loop.rs
index 88b9a82..e71ab03 100644
--- a/app/src/terminal/remote_tty/event_loop.rs
+++ b/app/src/terminal/remote_tty/event_loop.rs
@@ -112,6 +112,13 @@ enum HostControl {
     Session(String),
     /// The shell exited; there is nothing to reattach to.
     Exited(i32),
+    /// The running command turned off echo but kept line editing, like a password prompt.
+    PasswordPrompt,
+}
+
+pub(super) enum EventLoopEvent {
+    /// The PTY host saw what looks like a password prompt in the running command.
+    PossiblePasswordPrompt,
 }
 
 pub(super) struct EventLoop {
@@ -205,7 +212,7 @@ impl EventLoop {
         // TODO(alokedesai): Add a spawn_stream equivalent that runs on the background executor.
         ctx.spawn_stream_local(
             stream,
-            |event_loop, message, _| {
+            |event_loop, message, ctx| {
                 let message = match message {
                     Ok(message) => message,
                     Err(err) => {
@@ -217,7 +224,7 @@ impl EventLoop {
                 if let Some(bytes) = message.binary() {
                     event_loop.process_pty_bytes(bytes);
                 } else if let Some(text) = message.text() {
-                    event_loop.on_host_control(text);
+                    event_loop.on_host_control(text, ctx);
                 }
             },
             |event_loop, ctx| event_loop.on_connection_closed(ctx),
@@ -335,13 +342,14 @@ impl EventLoop {
         }
     }
 
-    fn on_host_control(&mut self, text: &str) {
+    fn on_host_control(&mut self, text: &str, ctx: &mut ModelContext<Self>) {
         match serde_json::from_str::<HostControl>(text) {
             Ok(HostControl::Session(id)) => self.session_id = Some(id),
             Ok(HostControl::Exited(code)) => {
                 log::info!("Remote shell exited with code {code}");
                 self.shell_exited = true;
             }
+            Ok(HostControl::PasswordPrompt) => ctx.emit(EventLoopEvent::PossiblePasswordPrompt),
             Err(_) => report_error!("Received unknown text message from the PTY host"),
         }
     }
@@ -508,7 +516,7 @@ impl EventLoop {
 }
 
 impl Entity for EventLoop {
-    type Event = ();
+    type Event = EventLoopEvent;
 }
 
 #[cfg(test)]
diff --git a/app/src/terminal/remote_tty/terminal_manager.rs b/app/src/terminal/remote_tty/terminal_manager.rs
index 09392cf..a17179f 100644
--- a/app/src/terminal/remote_tty/terminal_manager.rs
+++ b/app/src/terminal/remote_tty/terminal_manager.rs
@@ -14,7 +14,8 @@ use crate::persistence::ModelEvent;
 use crate::terminal::event_listener::ChannelEventListener;
 use crate::terminal::model::session::Sessions;
 use crate::terminal::model_events::ModelEventDispatcher;
-use crate::terminal::remote_tty::event_loop::EventLoop;
+use crate::terminal::remote_tty::event_loop::{EventLoop, EventLoopEvent};
+use crate::terminal::writeable_pty::terminal_surface::TerminalSurface as _;
 use crate::terminal::shell::ShellName;
 use crate::terminal::terminal_manager::BlockSpacing;
 use crate::terminal::writeable_pty::pty_controller::{EventLoopSendError, EventLoopSender};
@@ -146,6 +147,23 @@ impl TerminalManager {
             ctx,
         );
 
+        // The PTY host reports password prompts, which the poller notices on desktop.
+        let view_for_password_prompts = view.downgrade();
+        let model_for_password_prompts = model.clone();
+        ctx.subscribe_to_model(&event_loop, move |_, event, ctx| {
+            let EventLoopEvent::PossiblePasswordPrompt = event;
+            let Some(view) = view_for_password_prompts.upgrade(ctx) else {
+                return;
+            };
+            let block_index = model_for_password_prompts
+                .lock()
+                .block_list()
+                .active_block_index();
+            view.update(ctx, |view, ctx| {
+                view.on_possible_password_prompt(Some(block_index), ctx);
+            });
+        });
+
         // Clone the view before moving it into the manager so the caller can
         // receive it alongside the boxed manager.
         let terminal_view = view.clone();
