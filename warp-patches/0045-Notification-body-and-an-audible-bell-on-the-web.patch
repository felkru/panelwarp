diff --git a/app/src/terminal/audible_bell/web.rs b/app/src/terminal/audible_bell/web.rs
new file mode 100644
index 0000000..5857147
--- /dev/null
+++ b/app/src/terminal/audible_bell/web.rs
@@ -0,0 +1,16 @@
+//! Module containing a web implementation of an audible bell, played by the embedding host page.
+pub(super) struct AudibleBell;
+
+impl AudibleBell {
+    pub fn new() -> Self {
+        Self
+    }
+
+    pub fn ring(&self) -> anyhow::Result<()> {
+        if crate::platform::wasm::ring_bell_in_host() {
+            Ok(())
+        } else {
+            Err(anyhow::anyhow!("the host page doesn't provide a bell"))
+        }
+    }
+}
