@@ -307,6 +310,12 @@ pub fn reveal_file_in_host(path: &str) -> bool {
     ffi::reveal_file(path).is_ok()
 }
 
+/// Plays the terminal bell through the host's `window.warpPanelBell()`.
+/// Returns false if the host doesn't provide it.
+pub fn ring_bell_in_host() -> bool {
+    ffi::bell().is_ok()
+}
