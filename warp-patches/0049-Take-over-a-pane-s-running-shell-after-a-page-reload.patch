         self.registered_session_ids.insert(session_id);
     }
 
+    /// Registers a session of a shell that's bootstrapped already (see `adopted_session_ids`).
+    pub fn register_adopted_session_id(&mut self, session_id: SessionId) {
+        self.registered_session_ids.insert(session_id);
+        self.adopted_session_ids.insert(session_id);
+    }
+
+    /// Whether `InitShell` for this session is a replay of an adopted shell's (once per session).
+    pub fn take_adopted_session_id(&mut self, session_id: SessionId) -> bool {
+        self.adopted_session_ids.remove(&session_id)
+    }
+
     pub fn needs_bracketed_paste(&mut self) -> bool {
         delegate!(self.needs_bracketed_paste())
     }
