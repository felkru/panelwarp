+/// Hands an AI provider API key to the embedding host app, which stores it (VS Code:
+/// SecretStorage). Returns false if the host doesn't provide `window.warpPanelStoreApiKey`.
+pub fn store_api_key_in_host(provider: &str, key: &str) -> bool {
+    ffi::store_api_key(provider, key).is_ok()
+}
+
