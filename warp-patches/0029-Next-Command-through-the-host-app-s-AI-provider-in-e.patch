+/// Predicts the next command via the embedding host app's
+/// `window.warpPanelNextCommand(requestJson)`, which gets Warp's next-command request as JSON and
+/// resolves to the suggested command, or to null/empty when it has none.
+pub async fn next_command_in_host(request_json: String) -> Result<Option<String>, String> {
+    let promise = ffi::next_command(&request_json).map_err(|err| format!("{err:?}"))?;
+    let result = wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .map_err(|err| err.as_string().unwrap_or_else(|| format!("{err:?}")))?;
+    Ok(result
+        .as_string()
+        .map(|command| command.trim().to_owned())
+        .filter(|command| !command.is_empty()))
+}
