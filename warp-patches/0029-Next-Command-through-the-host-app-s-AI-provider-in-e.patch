+/// Next Command through the host's fast model; only available with private routing on.
+#[derive(Default)]
+struct HostAiNextCommandWidget {
+    toggle: SwitchStateHandle,
+}
+
+impl SettingsWidget for HostAiNextCommandWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "ai a.i. next command suggestions autosuggestions privacy"
+    }
+
+    fn render(&self, view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let settings = HostAiSettings::as_ref(app);
+        let private_routing = *settings.private_routing;
+        let toggle = render_ai_setting_toggle::<HostAiNextCommand>(
+            "Next Command",
+            WarpAgentPageAction::ToggleHostAiNextCommand,
+            *settings.next_command && private_routing,
+            private_routing,
+            self.toggle.clone(),
+            &view.local_only_icon_tooltip_states,
+            app,
+        );
+        let description = if private_routing {
+            "When a command finishes, the fast model suggests the next one as a grey \
+             autosuggestion (accept with \u{2192}). Sends recent commands and the last output."
+        } else {
+            "Only available with private routing on, since it sends command output."
+        };
+        let column = Flex::column()
+            .with_spacing(4.)
+            .with_child(toggle)
+            .with_child(
+                Text::new(description, appearance.ui_font_family(), CONTENT_FONT_SIZE)
+                    .with_color(styles::description_font_color(true, app).into())
+                    .finish(),
+            )
+            .finish();
+        host_setting_row(column)
+    }
+}
