 pub const HOST_AI_EFFORT_CHOICES: [&str; 4] = ["minimal", "low", "medium", "high"];
 
+/// How OpenRouter picks among the hosts serving a model (its `provider.sort`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum HostAiPriority {
+    /// OpenRouter's default load balancing (no `provider.sort`).
+    Balanced,
+    Latency,
+    Price,
+    Throughput,
+}
+
+impl HostAiPriority {
+    pub const ALL: [Self; 4] = [Self::Balanced, Self::Latency, Self::Price, Self::Throughput];
+
+    /// The stored setting value (and OpenRouter's `provider.sort` value, except `Balanced`).
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Balanced => "balanced",
+            Self::Latency => "latency",
+            Self::Price => "price",
+            Self::Throughput => "throughput",
+        }
+    }
+
+    pub fn from_setting(value: &str) -> Self {
+        Self::ALL
+            .into_iter()
+            .find(|priority| priority.as_str() == value)
+            .unwrap_or(Self::Balanced)
+    }
+}
