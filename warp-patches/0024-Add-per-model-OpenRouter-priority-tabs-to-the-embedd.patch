+/// Which OpenRouter hosts serve a stage's model first (OpenRouter's `provider.sort`).
+struct HostAiPriorityWidget {
+    kind: HostAiModelKind,
+    control: ViewHandle<SegmentedControl<HostAiPriority>>,
+}
+
+impl HostAiPriorityWidget {
+    fn new(kind: HostAiModelKind, ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let settings = HostAiSettings::as_ref(ctx);
+        let current = HostAiPriority::from_setting(match kind {
+            HostAiModelKind::Fast => &settings.fast_priority,
+            HostAiModelKind::Expanded => &settings.expanded_priority,
+        });
+        let control = ctx.add_typed_action_view(move |ctx| {
+            SegmentedControl::new(
+                HostAiPriority::ALL.to_vec(),
+                render_host_ai_priority_option,
+                current,
+                host_ai_priority_styles(ctx),
+            )
+        });
+        ctx.subscribe_to_view(&control, move |_, _, event, ctx| {
+            let SegmentedControlEvent::OptionSelected(priority) = event;
+            let value = priority.as_str().to_owned();
+            HostAiSettings::handle(ctx).update(ctx, |settings, ctx| match kind {
+                HostAiModelKind::Fast => {
+                    report_if_error!(settings.fast_priority.set_value(value, ctx))
+                }
+                HostAiModelKind::Expanded => {
+                    report_if_error!(settings.expanded_priority.set_value(value, ctx))
+                }
+            });
+        });
+        Self { kind, control }
+    }
+}
+
+fn render_host_ai_priority_option(
+    priority: HostAiPriority,
+    is_selected: bool,
+    app: &AppContext,
+) -> Option<RenderableOptionConfig> {
+    let theme = Appearance::as_ref(app).theme();
+    let (label, tooltip) = match priority {
+        HostAiPriority::Balanced => ("Balanced", "OpenRouter's default mix of price, speed and uptime."),
+        HostAiPriority::Latency => ("Latency", "Hosts that start answering soonest first."),
+        HostAiPriority::Price => ("Cost", "Cheapest hosts first."),
+        HostAiPriority::Throughput => ("Throughput", "Hosts that generate the most tokens per second first."),
+    };
+    Some(RenderableOptionConfig {
+        icon_path: "",
+        icon_color: theme.active_ui_text_color().into(),
+        label: Some(LabelConfig {
+            label: label.into(),
+            width_override: Some(76.),
+            color: if is_selected {
+                theme.active_ui_text_color().into()
+            } else {
+                theme.nonactive_ui_text_color().into()
+            },
+        }),
+        tooltip: Some(SegmentTooltipConfig {
+            text: tooltip.into(),
+            sub_text: None,
+            text_color: theme.active_ui_text_color().into(),
+            background_color: theme.surface_3().into(),
+            border_color: theme.outline().into(),
+        }),
+        background: if is_selected { Fill::Solid(theme.surface_3().into()) } else { Fill::None },
+    })
+}
+
+fn host_ai_priority_styles(app: &AppContext) -> UiComponentStyles {
+    let appearance = Appearance::as_ref(app);
+    let theme = appearance.theme();
+    UiComponentStyles {
+        font_family_id: Some(appearance.ui_font_family()),
+        font_size: Some(appearance.ui_font_size()),
+        border_radius: Some(CornerRadius::with_all(Radius::Pixels(4.))),
+        border_width: Some(1.),
+        border_color: Some(Fill::Solid(theme.outline().into())),
+        background: Some(Fill::Solid(theme.surface_2().into())),
+        height: Some(26.),
+        padding: Some(Coords::uniform(2.)),
+        ..Default::default()
+    }
+}
+
+impl SettingsWidget for HostAiPriorityWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        match self.kind {
+            HostAiModelKind::Fast => {
+                "ai provider openrouter fast model priority latency cost price throughput speed"
+            }
+            HostAiModelKind::Expanded => {
+                "ai provider openrouter expanded model priority latency cost price throughput speed"
+            }
+        }
+    }
+
+    fn render(&self, _view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let label = match self.kind {
+            HostAiModelKind::Fast => "Fast model priority",
+            HostAiModelKind::Expanded => "Expanded model priority",
+        };
+        let control = Flex::row()
+            .with_child(ChildView::new(&self.control).finish())
+            .finish();
+        render_host_setting_column(
+            label,
+            "Which OpenRouter hosts serving this model are tried first. \
+             Private routing still limits them to zero-data-retention hosts.",
+            control,
+            appearance,
+            app,
+        )
+    }
+}
