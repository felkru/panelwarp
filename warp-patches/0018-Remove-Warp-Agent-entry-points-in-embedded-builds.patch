-                    if !*InputSettings::as_ref(ctx).at_context_menu_in_terminal_mode {
+                    if !InputSettings::as_ref(ctx).is_at_context_menu_in_terminal_enabled() {
                         false
                     } else {
                         self.ai_context_menu_state
@@ -8707,7 +8707,7 @@ impl TypedActionView for EditorView {
                 if !self.is_ai_input && *open {
                     // In terminal mode, check the setting before opening
                     let input_settings = InputSettings::as_ref(ctx);
-                    if *input_settings.at_context_menu_in_terminal_mode {
+                    if input_settings.is_at_context_menu_in_terminal_enabled() {
                         ctx.emit(Event::SetAIContextMenuOpen(*open));
                     }
                     // If setting is false, don't emit the event to open the menu
diff --git a/app/src/settings/input.rs b/app/src/settings/input.rs
index 4263a94..df6f8f0 100644
--- a/app/src/settings/input.rs
+++ b/app/src/settings/input.rs
@@ -288,6 +288,19 @@ impl InputSettings {
     }
 
     pub fn is_terminal_input_message_bar_enabled(&self) -> bool {
-        *self.show_terminal_input_message_bar
+        // Embedded builds have no Warp Agent, so the bar's agent hints don't apply.
+        !cfg!(feature = "remote_tty") && *self.show_terminal_input_message_bar
+    }
+
+    /// Whether slash commands are available in the terminal input. Embedded builds have none of
+    /// the Warp Agent commands they offer.
+    pub fn is_slash_commands_in_terminal_enabled(&self) -> bool {
+        !cfg!(feature = "remote_tty") && *self.enable_slash_commands_in_terminal
+    }
+
+    /// Whether the @ context menu is available in terminal mode. Embedded builds have no Warp
+    /// Agent to attach context for.
+    pub fn is_at_context_menu_in_terminal_enabled(&self) -> bool {
+        !cfg!(feature = "remote_tty") && *self.at_context_menu_in_terminal_mode
     }
 }
