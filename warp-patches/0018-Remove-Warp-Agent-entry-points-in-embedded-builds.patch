From 06b23885bd7807dc6cff25fda77ddf89e7a5310d Mon Sep 17 00:00:00 2001
From: Felix Krueckel <hi@felkru.com>
Date: Wed, 7 Oct 2026 16:16:55 -0700
Subject: [PATCH 18/50] Remove Warp Agent entry points in embedded builds

No agent view (cmd+enter, /agent), no agent hint message bar, no zero
state block, and no slash command or @ menus in the terminal input.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/ai/blocklist/agent_view/controller.rs | 10 ++++++++++
 app/src/editor/view/mod.rs                    |  4 ++--
 app/src/settings/input.rs                     | 15 ++++++++++++++-
 app/src/terminal/input.rs                     |  5 +----
 app/src/terminal/input/slash_command_model.rs |  5 +----
 app/src/terminal/settings.rs                  |  4 +++-
 app/src/terminal/universal_developer_input.rs |  4 +---
 app/src/workspace/view.rs                     |  4 ++--
 8 files changed, 34 insertions(+), 17 deletions(-)

diff --git a/app/src/ai/blocklist/agent_view/controller.rs b/app/src/ai/blocklist/agent_view/controller.rs
index 62e8aea..2ff8612 100644
--- a/app/src/ai/blocklist/agent_view/controller.rs
+++ b/app/src/ai/blocklist/agent_view/controller.rs
@@ -26,6 +26,8 @@ pub enum EnterAgentViewError {
     AlreadyInAgentView,
     #[error("Cannot enter agent mode while a command is running.")]
     LongRunningCommand,
+    #[error("The Warp Agent isn't available in this build.")]
+    Unavailable,
 }
 
 /// Error returned when exiting the agent view fails.
@@ -733,6 +735,11 @@ impl AgentViewController {
         origin: AgentViewEntryOrigin,
         ctx: &mut ModelContext<Self>,
     ) -> Result<AIConversationId, EnterAgentViewError> {
+        // Embedded builds have no Warp Agent (their AI is the host's # command search).
+        if cfg!(feature = "remote_tty") {
+            return Err(EnterAgentViewError::Unavailable);
+        }
+
         // Block entry to fullscreen mode if there's an active long-running command. Transcript
         // viewers and 3p cloud viewers are exempt: in those contexts the long-running block is
         // either a restored snapshot or the harness CLI we want to wrap in agent-view chrome.
@@ -768,6 +775,9 @@ impl AgentViewController {
         origin: AgentViewEntryOrigin,
         ctx: &mut ModelContext<Self>,
     ) -> Result<AIConversationId, EnterAgentViewError> {
+        if cfg!(feature = "remote_tty") {
+            return Err(EnterAgentViewError::Unavailable);
+        }
         if self.agent_view_state.is_active() {
             return Err(EnterAgentViewError::AlreadyInAgentView);
         }
