 app/src/search/command_search/view.rs       |  9 +++++
 app/src/search/command_search/zero_state.rs |  3 ++
 app/src/user_config/wasm.rs                 |  3 ++
 app/src/workflows/info_box.rs               |  4 ++-
 5 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/app/src/platform/wasm.rs b/app/src/platform/wasm.rs
index b64bd29..2375aed 100644
--- a/app/src/platform/wasm.rs
+++ b/app/src/platform/wasm.rs
@@ -36,6 +36,9 @@ mod ffi {
         #[wasm_bindgen(js_name = "warpPanelCommandHistory", catch)]
         pub fn command_history() -> Result<Option<String>, JsValue>;
 
