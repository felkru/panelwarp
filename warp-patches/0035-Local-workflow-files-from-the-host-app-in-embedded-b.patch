         #[wasm_bindgen(js_name = "warpPanelRecordCommand", catch)]
         pub fn record_command(kind: &str, json: &str) -> Result<(), JsValue>;
 
@@ -276,6 +279,41 @@ pub fn user_handoff() -> Result<Option<String>, AuthHandoffError> {
 /// extension's storage, mirroring desktop Warp's), since the web build has no local database.
 /// Rows mirror `persistence::model::Command`; timestamps are RFC 3339, session ids decimal strings.
 #[cfg(feature = "remote_tty")]
+/// Local workflow files (`~/.warp/workflows` and the workspace's `.warp/workflows`), read by the
+/// host app since the web build has no file system, and parsed here like desktop Warp does.
+pub mod host_workflows {
+    use serde::Deserialize;
+
+    use crate::workflows::workflow::Workflow;
+
+    #[derive(Deserialize)]
+    struct WorkflowFile {
+        name: String,
+        text: String,
+    }
+
+    /// Every workflow in the host's files; a file can hold several YAML documents.
+    pub fn load() -> Vec<Workflow> {
+        let Some(json) = super::ffi::workflows().ok().flatten() else {
+            return Vec::new();
+        };
+        let files: Vec<WorkflowFile> = serde_json::from_str(&json).unwrap_or_default();
+        files
+            .into_iter()
+            .flat_map(|file| {
+                let parsed: Result<Vec<Workflow>, _> =
+                    serde_yaml::Deserializer::from_str(&file.text)
+                        .map(Workflow::deserialize)
+                        .collect();
+                parsed.unwrap_or_else(|error| {
+                    log::warn!("Failed to parse workflow file {}: {error}", file.name);
+                    Vec::new()
+                })
+            })
+            .collect()
+    }
+}
+
 pub mod host_history {
     use chrono::{DateTime, Local};
     use serde::{Deserialize, Serialize};
