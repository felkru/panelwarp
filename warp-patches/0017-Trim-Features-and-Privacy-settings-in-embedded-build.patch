From 2c9702e5bc5e36d5ef09641f34d289bf1f884f8f Mon Sep 17 00:00:00 2001
From: Felix Krueckel <hi@felkru.com>
Date: Wed, 7 Oct 2026 16:16:55 -0700
Subject: [PATCH 17/49] Trim Features and Privacy settings in embedded builds

Telemetry and crash reports are forced off. The Privacy page keeps only
secret redaction. Features drops the agent bar, default mode, changelog,
@ menu, slash commands and code outline rows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/settings/privacy.rs            | 23 +++++++++++----
 app/src/settings_view/features_page.rs | 40 ++++++++++++++++----------
 app/src/settings_view/privacy_page.rs  |  8 ++++++
 3 files changed, 50 insertions(+), 21 deletions(-)

diff --git a/app/src/settings/privacy.rs b/app/src/settings/privacy.rs
index c11710c..e8a3fa6 100644
--- a/app/src/settings/privacy.rs
+++ b/app/src/settings/privacy.rs
@@ -139,6 +139,9 @@ maybe_define_setting!(HasInitializedDefaultSecretRegexes, group: PrivacySettings
     private: true,
 });
 
+/// Embedded (`remote_tty`) builds force telemetry and crash reporting off.
+const EMBEDDED: bool = cfg!(feature = "remote_tty");
+
 /// Singleton model for managing the user's privacy settings (whether the user has enabled crash
 /// reporting and/or telemetry).
 pub struct PrivacySettings {
@@ -196,6 +199,9 @@ impl PrivacySettingsSnapshot {
     }
 
     pub fn should_disable_telemetry(&self) -> bool {
+        if EMBEDDED {
+            return true;
+        }
         // If a user has opted in to the agent mode analytics experiment, telemetry must be enabled.
         !self.is_telemetry_enabled
             && !self.is_telemetry_force_enabled
@@ -246,8 +252,11 @@ impl PrivacySettings {
         // Initialize from `WarpDrivePrivacySettings`, which is the source of truth for these
         // booleans.
         let warp_drive_privacy = WarpDrivePrivacySettings::as_ref(ctx);
-        let is_telemetry_enabled = *warp_drive_privacy.is_telemetry_enabled.value();
-        let is_crash_reporting_enabled = *warp_drive_privacy.is_crash_reporting_enabled.value();
+        // Embedded (`remote_tty`) builds never send telemetry or crash reports.
+        let is_telemetry_enabled =
+            !EMBEDDED && *warp_drive_privacy.is_telemetry_enabled.value();
+        let is_crash_reporting_enabled =
+            !EMBEDDED && *warp_drive_privacy.is_crash_reporting_enabled.value();
         let is_cloud_conversation_storage_enabled = *warp_drive_privacy
             .is_cloud_conversation_storage_enabled
             .value();
@@ -308,7 +317,7 @@ impl PrivacySettings {
     }
 
     pub fn set_is_telemetry_force_enabled(&mut self, is_telemetry_force_enabled: bool) {
-        self.is_telemetry_force_enabled = is_telemetry_force_enabled;
+        self.is_telemetry_force_enabled = is_telemetry_force_enabled && !EMBEDDED;
     }
 
     pub fn is_enterprise_secret_redaction_enabled(&self) -> bool {
@@ -365,8 +374,8 @@ impl PrivacySettings {
 
     pub fn refresh_to_default(&mut self) {
         // TODO(zach): this seems incorrect - should we also update the values on disk?
-        self.is_telemetry_enabled = true;
-        self.is_crash_reporting_enabled = true;
+        self.is_telemetry_enabled = !EMBEDDED;
+        self.is_crash_reporting_enabled = !EMBEDDED;
         self.is_cloud_conversation_storage_enabled = true;
         self.is_telemetry_force_enabled = false;
         self.is_enterprise_secret_redaction_enabled = false;
@@ -478,7 +487,7 @@ impl PrivacySettings {
                 .then_some(false),
             is_telemetry_enabled: self.is_telemetry_enabled,
             is_crash_reporting_enabled: self.is_crash_reporting_enabled,
-            is_telemetry_force_enabled: self.is_telemetry_force_enabled,
+            is_telemetry_force_enabled: self.is_telemetry_force_enabled && !EMBEDDED,
             should_collect_ai_ugc_telemetry: should_collect_ai_ugc_telemetry(
                 app,
                 self.is_telemetry_enabled,
@@ -496,6 +505,7 @@ impl PrivacySettings {
         new_value: bool,
         ctx: &mut ModelContext<PrivacySettings>,
     ) {
+        let new_value = new_value && !EMBEDDED;
         let old_value = self.is_crash_reporting_enabled;
         if new_value != old_value {
             self.is_crash_reporting_enabled = new_value;
@@ -532,6 +542,7 @@ impl PrivacySettings {
         new_value: bool,
         ctx: &mut ModelContext<PrivacySettings>,
     ) {
+        let new_value = new_value && !EMBEDDED;
         let old_value = self.is_telemetry_enabled;
         if new_value != old_value {
             self.is_telemetry_enabled = new_value;
