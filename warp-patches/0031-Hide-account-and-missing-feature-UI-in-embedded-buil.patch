+
+/// Whether a binding belongs to a feature this build doesn't have (see
+/// [`HIDDEN_IN_EMBEDDED_BINDINGS`]; slash commands, named after their command like "/agent", are
+/// off in embedded builds too). Always false outside embedded builds.
+pub fn is_binding_hidden(name: &str) -> bool {
+    cfg!(feature = "remote_tty")
+        && (name.starts_with('/') || HIDDEN_IN_EMBEDDED_BINDINGS.contains(&name))
+}
