From 5181e8238508ec93c1ef39561180ea9ccbff9a85 Mon Sep 17 00:00:00 2001
From: Felix Krueckel <hi@felkru.com>
Date: Wed, 7 Oct 2026 13:33:29 -0700
Subject: [PATCH 02/54] embedded: skip Warp sign-in and the desktop-download
 dialog

remote_tty builds run inside a host app without Warp accounts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/root_view.rs       | 12 ++++++++++++
 app/src/wasm_nux_dialog.rs |  6 ++++++
 2 files changed, 18 insertions(+)

diff --git a/app/src/root_view.rs b/app/src/root_view.rs
index f9389ca..2bb6c50 100644
--- a/app/src/root_view.rs
+++ b/app/src/root_view.rs
@@ -3769,6 +3769,13 @@ impl RootView {
         match event {
             WebHandoffEvent::Unsupported => {
                 log::warn!("Web auth handoff is unavailable");
+                // `remote_tty` builds are embedded in a host app without Warp accounts, so skip
+                // the sign-in screen as if the user had chosen "Skip login".
+                let skip_login = cfg!(feature = "remote_tty")
+                    && matches!(
+                        &self.auth_onboarding_state,
+                        AuthOnboardingState::WebImport(AuthOnboardingTarget::Workspace(_))
+                    );
                 if let AuthOnboardingState::WebImport(target) = &self.auth_onboarding_state {
                     self.auth_onboarding_state = match target {
                         AuthOnboardingTarget::Workspace(args) => {
@@ -3788,6 +3795,11 @@ impl RootView {
                 } else {
                     report_error!("Received web handoff event in unexpected state");
                 }
+                if skip_login {
+                    AuthManager::handle(ctx).update(ctx, |_, ctx| {
+                        ctx.emit(AuthManagerEvent::SkippedLogin);
+                    });
+                }
                 self.focus(ctx);
             }
         }
diff --git a/app/src/wasm_nux_dialog.rs b/app/src/wasm_nux_dialog.rs
index 3a8f024..b7ebb39 100644
--- a/app/src/wasm_nux_dialog.rs
+++ b/app/src/wasm_nux_dialog.rs
@@ -78,6 +78,12 @@ impl WasmNUXDialog {
     /// If the user dismisses the dialog without choosing a preference, we'll continue to use the default autodetection
     /// behavior: if Warp is installed, redirect to it; otherwise stay on the web.
     pub fn should_display(app: &AppContext) -> bool {
+        // `remote_tty` builds are embedded in a host app (e.g. the VS Code panel), where a
+        // desktop-download prompt makes no sense.
+        if cfg!(feature = "remote_tty") {
+            return false;
+        }
+
         // Don't show on mobile devices - they can't use the desktop app
         if warpui::platform::wasm::is_mobile_device() {
             return false;
