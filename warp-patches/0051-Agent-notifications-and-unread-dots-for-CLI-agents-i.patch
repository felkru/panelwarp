+/// A conversation that runs in one of Warp's panes.
+struct WarpPane {
+    terminal_view_id: EntityId,
+    unread: bool,
+}
+
+/// The host's name for a CLI agent, as in `HostAgentConversation::agent`.
+fn host_agent_name(agent: CLIAgent) -> Option<&'static str> {
+    match agent {
+        CLIAgent::Claude => Some("claude"),
+        CLIAgent::Codex => Some("codex"),
+        CLIAgent::Gemini => Some("gemini"),
+        _ => None,
+    }
+}
+
+/// Conversations running in Warp's panes, by (host agent name, conversation id). Only agents
+/// whose plugin reports its session id (e.g. Warp's Claude Code plugin) can be matched.
+fn warp_panes(app: &AppContext) -> HashMap<(&'static str, &str), WarpPane> {
+    let notifications = AgentNotificationsModel::as_ref(app).notifications();
+    CLIAgentSessionsModel::as_ref(app)
+        .sessions()
+        .filter_map(|(terminal_view_id, session)| {
+            let agent = host_agent_name(session.agent)?;
+            let id = session.session_context.session_id.as_deref()?;
+            Some((
+                (agent, id),
+                WarpPane {
+                    terminal_view_id,
+                    unread: notifications.has_unread_for_terminal_view(terminal_view_id),
+                },
+            ))
+        })
+        .collect()
+}
