+/// A file path in terminal output that exists, as resolved by the host.
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HostResolvedPath {
+    pub absolute_path: String,
+    #[serde(default)]
+    pub is_dir: bool,
+}
+
+/// Resolves possible file paths found in terminal output via the host's
+/// `window.warpPanelResolvePaths(cwd, candidatesJson)`: relative paths against `cwd`, `~` to the
+/// home directory. Resolves to one entry per candidate, in order: the path if it exists, else
+/// None. All None if the host doesn't provide it or fails.
+pub async fn resolve_paths_in_host(
+    cwd: String,
+    candidates: Vec<String>,
+) -> Vec<Option<HostResolvedPath>> {
+    let unresolved = || candidates.iter().map(|_| None).collect();
+    let Ok(candidates_json) = serde_json::to_string(&candidates) else {
+        return unresolved();
+    };
+    let Ok(promise) = ffi::resolve_paths(&cwd, &candidates_json) else {
+        return unresolved();
+    };
+    let Some(json) = wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .ok()
+        .and_then(|value| value.as_string())
+    else {
+        return unresolved();
+    };
+    match serde_json::from_str::<Vec<Option<HostResolvedPath>>>(&json) {
+        Ok(resolved) if resolved.len() == candidates.len() => resolved,
+        _ => unresolved(),
+    }
+}
+
+/// Opens a file in the host's editor (VS Code), at `line`/`column` (1-based) if given.
+/// Returns false if the host doesn't provide `window.warpPanelOpenFile`.
+pub fn open_file_in_host(path: &str, line: Option<u32>, column: Option<u32>) -> bool {
+    ffi::open_file(path, line, column).is_ok()
+}
+
+/// Reveals a file or directory in the host's file explorer (VS Code's Explorer).
+/// Returns false if the host doesn't provide `window.warpPanelRevealFile`.
+pub fn reveal_file_in_host(path: &str) -> bool {
+    ffi::reveal_file(path).is_ok()
+}
