diff --git a/app/src/terminal/view.rs b/app/src/terminal/view.rs
index 513ea7d..b2e179d 100644
--- a/app/src/terminal/view.rs
+++ b/app/src/terminal/view.rs
@@ -24389,6 +24389,20 @@ impl TerminalView {
     }
 
     pub fn pwd_if_local(&self, ctx: &AppContext) -> Option<String> {
+        // On the web, every session is "remote", but the PTY host's own shell runs on the user's
+        // machine; only an SSH session or a subshell started from it is elsewhere.
+        #[cfg(feature = "remote_tty")]
+        {
+            let session = self
+                .active_block_session_id()
+                .and_then(|id| self.sessions.as_ref(ctx).get(id))?;
+            // `is_subshell_or_ssh` is always true here: every web session is `WarpifiedRemote`.
+            if session.is_ssh_wrapper_session() || session.subshell_info().is_some() {
+                return None;
+            }
+            return self.pwd();
+        }
+        #[cfg_attr(feature = "remote_tty", allow(unreachable_code))]
         self.active_session_path_if_local(ctx)
             .map(|path| path.to_string_lossy().into_owned())
     }
