+
+/// Tabs restored across panel reloads and VS Code windows, like desktop Warp's session
+/// restoration, which keeps them in SQLite: the embedding host stores the latest layout (tabs,
+/// splits, titles, each terminal's directory) and recent blocks per terminal pane in its own SQLite
+/// file (VS Code: `sessionStore.js`), and hands back the latest at startup.
+#[cfg(feature = "remote_tty")]
+pub mod host_session {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::sync::Arc;
+
+    use serde::{Deserialize, Serialize};
+
+    use crate::ai::blocklist::SerializedBlockListItem;
+    use crate::app_state::{
+        AppState, BranchSnapshot, LeafContents, LeafSnapshot, PaneFlex, PaneNodeSnapshot,
+        PaneUuid, SplitDirection, TabSnapshot, TerminalPaneSnapshot, WindowSnapshot,
+    };
+    use crate::tab::SelectedTabColor;
+    use crate::terminal::model::block::SerializedBlock;
+
+    #[derive(Serialize, Deserialize, PartialEq)]
+    #[serde(rename_all = "camelCase")]
+    struct Session {
+        windows: Vec<Window>,
+        active_window_index: Option<usize>,
+    }
+
+    #[derive(Serialize, Deserialize, PartialEq)]
+    #[serde(rename_all = "camelCase")]
+    struct Window {
+        tabs: Vec<Tab>,
+        active_tab_index: usize,
+        #[serde(default)]
+        vertical_tabs_panel_open: bool,
+    }
+
+    #[derive(Serialize, Deserialize, PartialEq)]
+    #[serde(rename_all = "camelCase")]
+    struct Tab {
+        custom_title: Option<String>,
+        #[serde(default)]
+        selected_color: SelectedTabColor,
+        #[serde(default)]
+        pinned: bool,
+        root: Node,
+    }
+
+    /// A pane tree node; only terminal panes are kept (others reopen from VS Code itself).
+    #[derive(Serialize, Deserialize, PartialEq)]
+    #[serde(rename_all = "camelCase", rename_all_fields = "camelCase")]
+    enum Node {
+        Branch {
+            vertical: bool,
+            children: Vec<Child>,
+        },
+        Terminal {
+            /// The pane's id in hex; its blocks are stored under it.
+            uuid: String,
+            cwd: Option<String>,
+            #[serde(default)]
+            is_focused: bool,
+            #[serde(default)]
+            is_active: bool,
+            #[serde(default)]
+            custom_vertical_tabs_title: Option<String>,
+        },
+    }
+
+    #[derive(Serialize, Deserialize, PartialEq)]
+    struct Child {
+        flex: f32,
+        node: Node,
+    }
+
+    #[derive(Deserialize)]
+    struct Stored {
+        session: Session,
+        #[serde(default)]
+        blocks: HashMap<String, Vec<SerializedBlock>>,
+    }
+
+    thread_local! {
+        /// The last layout sent, so unchanged layouts aren't sent again.
+        static LAST_SAVED: RefCell<Option<String>> = const { RefCell::new(None) };
+    }
+
+    /// The tabs to restore, with their panes' blocks; None if the host has none.
+    pub fn load() -> Option<AppState> {
+        let json = super::ffi::session().ok().flatten()?;
+        let stored: Stored = match serde_json::from_str(&json) {
+            Ok(stored) => stored,
+            Err(err) => {
+                log::warn!("Ignoring unreadable saved tabs: {err}");
+                return None;
+            }
+        };
+        let block_lists = stored
+            .blocks
+            .into_iter()
+            .filter_map(|(uuid, blocks)| {
+                let uuid = hex::decode(uuid).ok()?;
+                let items = blocks
+                    .into_iter()
+                    .map(|block| SerializedBlockListItem::Command {
+                        block: Box::new(block),
+                    })
+                    .collect();
+                Some((PaneUuid(uuid), items))
+            })
+            .collect();
+        let windows: Vec<WindowSnapshot> = stored
+            .session
+            .windows
+            .into_iter()
+            .filter_map(window_snapshot)
+            .collect();
+        if windows.is_empty() {
+            return None;
+        }
+        let active_window_index = stored
+            .session
+            .active_window_index
+            .filter(|index| *index < windows.len());
+        Some(AppState {
+            windows,
+            active_window_index,
+            block_lists: Arc::new(block_lists),
+            running_mcp_servers: Vec::new(),
+        })
+    }
+
+    /// Sends the current layout to the host if it changed since the last save.
+    pub fn save(app_state: &AppState) {
+        let session = Session {
+            windows: app_state.windows.iter().filter_map(window).collect(),
+            active_window_index: app_state.active_window_index,
+        };
+        // Nothing to restore: e.g. the page is still starting, or every tab was closed (then the
+        // panel opens a fresh tab anyway).
+        if session.windows.is_empty() {
+            return;
+        }
+        let Ok(json) = serde_json::to_string(&session) else {
+            return;
+        };
+        let changed = LAST_SAVED.with(|last| {
+            let mut last = last.borrow_mut();
+            if last.as_deref() == Some(json.as_str()) {
+                return false;
+            }
+            *last = Some(json.clone());
+            true
+        });
+        if changed {
+            let _ = super::ffi::save_session(&json);
+        }
+    }
+
+    /// How often the layout is checked for changes; the panel can close (window closed, VS Code
+    /// quit) without warning, so this bounds what's lost.
+    const AUTOSAVE_INTERVAL: std::time::Duration = std::time::Duration::from_secs(2);
+
+    /// Saves the layout every [`AUTOSAVE_INTERVAL`] (only sent when it changed), on top of the
+    /// window events desktop Warp saves on.
+    pub struct Autosave;
+
+    impl Autosave {
+        pub fn new(ctx: &mut warpui::ModelContext<Self>) -> Self {
+            Self::schedule(ctx);
+            Self
+        }
+
+        fn schedule(ctx: &mut warpui::ModelContext<Self>) {
+            ctx.spawn(
+                warpui::r#async::Timer::after(AUTOSAVE_INTERVAL),
+                |_, _, ctx| {
+                    ctx.dispatch_global_action("workspace:save_app", &());
+                    Self::schedule(ctx);
+                },
+            );
+        }
+    }
+
+    impl warpui::Entity for Autosave {
+        type Event = ();
+    }
+
+    impl warpui::SingletonEntity for Autosave {}
+
+    /// Sends a finished block of a terminal pane to the host.
+    pub fn save_block(pane_uuid: &[u8], block: &SerializedBlock) {
+        if let Ok(json) = serde_json::to_string(block) {
+            let _ = super::ffi::save_block(&hex::encode(pane_uuid), &json);
+        }
+    }
+
+    fn window(snapshot: &WindowSnapshot) -> Option<Window> {
+        if snapshot.quake_mode {
+            return None;
+        }
+        let mut active_tab_index = snapshot.active_tab_index;
+        let mut tabs = Vec::new();
+        for (index, tab) in snapshot.tabs.iter().enumerate() {
+            match self::tab(tab) {
+                Some(tab) => tabs.push(tab),
+                None if index < snapshot.active_tab_index => active_tab_index -= 1,
+                None => {}
+            }
+        }
+        if tabs.is_empty() {
+            return None;
+        }
+        Some(Window {
+            active_tab_index: active_tab_index.min(tabs.len() - 1),
+            tabs,
+            vertical_tabs_panel_open: snapshot.vertical_tabs_panel_open,
+        })
+    }
+
+    fn tab(snapshot: &TabSnapshot) -> Option<Tab> {
+        Some(Tab {
+            custom_title: snapshot.custom_title.clone(),
+            selected_color: snapshot.selected_color,
+            pinned: snapshot.pinned,
+            root: node(&snapshot.root)?,
+        })
+    }
+
+    fn node(snapshot: &PaneNodeSnapshot) -> Option<Node> {
+        match snapshot {
+            PaneNodeSnapshot::Branch(BranchSnapshot {
+                direction,
+                children,
+            }) => {
+                let mut children: Vec<Child> = children
+                    .iter()
+                    .filter_map(|(flex, child)| {
+                        Some(Child {
+                            flex: flex.0,
+                            node: node(child)?,
+                        })
+                    })
+                    .collect();
+                match children.len() {
+                    0 => None,
+                    1 => children.pop().map(|child| child.node),
+                    _ => Some(Node::Branch {
+                        vertical: *direction == SplitDirection::Vertical,
+                        children,
+                    }),
+                }
+            }
+            PaneNodeSnapshot::Leaf(LeafSnapshot {
+                is_focused,
+                custom_vertical_tabs_title,
+                contents: LeafContents::Terminal(terminal),
+            }) => Some(Node::Terminal {
+                uuid: hex::encode(&terminal.uuid),
+                cwd: terminal.cwd.clone(),
+                is_focused: *is_focused,
+                is_active: terminal.is_active,
+                custom_vertical_tabs_title: custom_vertical_tabs_title.clone(),
+            }),
+            PaneNodeSnapshot::Leaf(_) => None,
+        }
+    }
+
+    fn window_snapshot(window: Window) -> Option<WindowSnapshot> {
+        let tabs: Vec<TabSnapshot> = window.tabs.into_iter().filter_map(tab_snapshot).collect();
+        if tabs.is_empty() {
+            return None;
+        }
+        Some(WindowSnapshot {
+            active_tab_index: window.active_tab_index.min(tabs.len() - 1),
+            tabs,
+            team_uid: None,
+            bounds: None,
+            fullscreen_state: Default::default(),
+            quake_mode: false,
+            universal_search_width: None,
+            warp_ai_width: None,
+            voltron_width: None,
+            warp_drive_index_width: None,
+            left_panel_open: false,
+            vertical_tabs_panel_open: window.vertical_tabs_panel_open,
+            left_panel_width: None,
+            right_panel_width: None,
+            agent_management_filters: None,
+            tab_groups: Vec::new(),
+        })
+    }
+
+    fn tab_snapshot(tab: Tab) -> Option<TabSnapshot> {
+        Some(TabSnapshot {
+            custom_title: tab.custom_title,
+            root: node_snapshot(tab.root)?,
+            default_directory_color: None,
+            selected_color: tab.selected_color,
+            left_panel: None,
+            right_panel: None,
+            group_id: None,
+            pinned: tab.pinned,
+        })
+    }
+
+    fn node_snapshot(node: Node) -> Option<PaneNodeSnapshot> {
+        match node {
+            Node::Branch { vertical, children } => {
+                let children: Vec<(PaneFlex, PaneNodeSnapshot)> = children
+                    .into_iter()
+                    .filter_map(|child| Some((PaneFlex(child.flex), node_snapshot(child.node)?)))
+                    .collect();
+                if children.is_empty() {
+                    return None;
+                }
+                Some(PaneNodeSnapshot::Branch(BranchSnapshot {
+                    direction: if vertical {
+                        SplitDirection::Vertical
+                    } else {
+                        SplitDirection::Horizontal
+                    },
+                    children,
+                }))
+            }
+            Node::Terminal {
+                uuid,
+                cwd,
+                is_focused,
+                is_active,
+                custom_vertical_tabs_title,
+            } => Some(PaneNodeSnapshot::Leaf(LeafSnapshot {
+                is_focused,
+                custom_vertical_tabs_title,
+                contents: LeafContents::Terminal(TerminalPaneSnapshot {
+                    uuid: hex::decode(uuid).ok()?,
+                    cwd,
+                    shell_launch_data: None,
+                    is_active,
+                    is_read_only: false,
+                    input_config: None,
+                    llm_model_override: None,
+                    active_profile_id: None,
+                    conversation_ids_to_restore: Vec::new(),
+                    active_conversation_id: None,
+                }),
+            })),
+        }
+    }
+}
