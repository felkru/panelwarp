-                            Ok(newer) => sink = newer,
-                            Err(_) => return,
+
+                    for message in batch {
+                        let Some(outgoing) = Self::to_outgoing(message) else {
+                            continue;
+                        };
+
+                        // Hold the message while disconnected, switch to the newest
+                        // connection, then send; if the send fails, wait for a reconnect.
+                        if !connected.load(Ordering::SeqCst) {
+                            match new_sinks.recv().await {
+                                Ok(newer) => sink = newer,
+                                Err(_) => return,
+                            }
+                        }
+                        while let Ok(newer) = new_sinks.try_recv() {
+                            sink = newer;
+                        }
+                        while sink.send(outgoing.to_message()).await.is_err() {
+                            match new_sinks.recv().await {
