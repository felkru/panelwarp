 /// running meanwhile.
 const MAX_RECONNECT_ATTEMPTS: u32 = 200;
 
+/// How long a resize waits for further resizes before only the latest is sent to the shell.
+const RESIZE_COALESCE: Duration = Duration::from_millis(50);
+
 type BoxedSink = Pin<Box<dyn futures::Sink<Message, Error = websocket::Error> + Send>>;
 
 /// A message for the PTY host, rebuilt for every send attempt so it can be retried on a new
@@ -215,46 +218,50 @@ impl EventLoop {
                     report_error!(e.context("Failed to write zsh bootstrap bytes to pty"));
                 }
 
