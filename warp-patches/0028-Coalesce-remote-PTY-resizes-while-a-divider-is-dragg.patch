+                while let Ok(first) = receiver.recv().await {
+                    let mut batch = vec![first];
+                    if matches!(batch[0], EventLoopMessage::Resize(_)) {
+                        // Dragging a divider resizes on every mouse move, and each resize makes
+                        // the shell redraw; let the size settle and send only the latest one.
+                        Timer::after(RESIZE_COALESCE).await;
+                        while let Ok(next) = receiver.try_recv() {
+                            batch.push(next);
                         }
+                        let last_resize = batch
+                            .iter()
+                            .rposition(|message| matches!(message, EventLoopMessage::Resize(_)));
+                        batch = batch
+                            .into_iter()
+                            .enumerate()
+                            .filter(|(index, message)| {
+                                !matches!(message, EventLoopMessage::Resize(_))
+                                    || Some(*index) == last_resize
+                            })
+                            .map(|(_, message)| message)
+                            .collect();
                     }
-                    while let Ok(newer) = new_sinks.try_recv() {
