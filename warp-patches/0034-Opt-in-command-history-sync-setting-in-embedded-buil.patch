+/// Opt-in sync of the newest commands across machines, done by the host app (VS Code Settings
+/// Sync), in embedded builds.
+#[derive(Default)]
+struct HostHistorySyncWidget {
+    switch_state: SwitchStateHandle,
+}
+
+impl SettingsWidget for HostHistorySyncWidget {
+    type View = PrivacyPageView;
+
+    fn search_terms(&self) -> &str {
+        "command history sync machines settings sync"
+    }
+
+    fn render(
+        &self,
+        view: &Self::View,
+        appearance: &Appearance,
+        app: &AppContext,
+    ) -> Box<dyn Element> {
+        let ui_builder = appearance.ui_builder();
+        let local_only_icon_state = LocalOnlyIconState::for_setting(
+            HostHistorySync::storage_key(),
+            HostHistorySync::sync_to_cloud(),
+            &mut view.local_only_icon_tooltip_states.borrow_mut(),
+            app,
+        );
+        Flex::column()
+            .with_child(render_body_item::<PrivacyPageAction>(
+                "Sync command history".into(),
+                None,
+                local_only_icon_state,
+                ToggleState::Enabled,
+                appearance,
+                ui_builder
+                    .switch(self.switch_state.clone())
+                    .check(*HostAiSettings::as_ref(app).history_sync)
+                    .build()
+                    .on_click(move |ctx, _, _| {
+                        ctx.dispatch_typed_action(PrivacyPageAction::ToggleHostHistorySync)
+                    })
+                    .finish(),
+                None,
+            ))
+            .with_child(
+                ui_builder
+                    .paragraph(
+                        "Syncs your newest 500 commands to your other machines with VS Code \
+                         Settings Sync. Commands can contain secrets; ones starting with a space \
+                         aren't synced. Turning this off removes the synced copy."
+                            .to_owned(),
+                    )
+                    .with_style(UiComponentStyles {
+                        font_color: Some(
+                            appearance
+                                .theme()
+                                .sub_text_color(appearance.theme().surface_2())
+                                .into_solid(),
+                        ),
+                        margin: Some(
+                            Coords::default()
+                                .top(styles::DESCRIPTION_NEGATIVE_MARGIN_OFFSET)
+                                .bottom(styles::DESCRIPTION_MARGIN_BOTTOM),
+                        ),
+                        ..Default::default()
+                    })
+                    .build()
+                    .finish(),
+            )
+            .finish()
+    }
+}
+
