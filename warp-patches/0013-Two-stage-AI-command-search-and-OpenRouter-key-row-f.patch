-    let promise = ffi::generate_commands(&prompt, context_json).map_err(|_| Error::Other)?;
+    let promise = ffi::generate_commands(&prompt, context_json, stage).map_err(|_| Error::Other)?;
     let result = wasm_bindgen_futures::JsFuture::from(promise)
         .await
         .map_err(|err| match err.as_string().as_deref() {
