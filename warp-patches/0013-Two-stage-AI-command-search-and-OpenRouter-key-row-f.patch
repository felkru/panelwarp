+                // Embedded builds: a slower model adds more options once typing pauses longer.
+                // Added first so its late results sit above the fast stage's.
+                #[cfg(feature = "remote_tty")]
+                mixer.add_async_source(
+                    WarpAIDataSource::new(self.ai_client.clone(), ai_execution_context.clone())
+                        .with_host_stage("expanded"),
+                    HashSet::from([QueryFilter::NaturalLanguage]),
+                    AddAsyncSourceOptions {
+                        debounce_interval: Some(ai_debounce.max(EXPANDED_AI_SEARCH_MIN_DEBOUNCE)),
+                        run_in_zero_state: false,
+                        run_when_unfiltered: false,
+                    },
+                    ctx,
+                );
                 mixer.add_async_source(
                     WarpAIDataSource::new(self.ai_client.clone(), ai_execution_context),
