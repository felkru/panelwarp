+/// Delay choices for AI Command Search, in milliseconds (50 is Warp's original behavior).
+const AI_COMMAND_SEARCH_DEBOUNCE_CHOICES: [u32; 5] = [50, 200, 400, 800, 1500];
+
+/// How long AI Command Search waits after typing stops before requesting suggestions.
+struct AiCommandSearchDebounceWidget {
+    dropdown: ViewHandle<Dropdown<WarpAgentPageAction>>,
+}
+
+impl AiCommandSearchDebounceWidget {
+    fn new(ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let items: Vec<DropdownItem<WarpAgentPageAction>> = AI_COMMAND_SEARCH_DEBOUNCE_CHOICES
+            .into_iter()
+            .map(|ms| {
+                DropdownItem::new(
+                    format!("{ms} ms"),
+                    WarpAgentPageAction::SetAiCommandSearchDebounceMs(ms),
+                )
+            })
+            .collect();
+        let current = *InputSettings::as_ref(ctx).ai_command_search_debounce_ms;
+        let dropdown = ctx.add_typed_action_view(|ctx| {
+            let mut dropdown = Dropdown::new(ctx);
+            dropdown.set_top_bar_max_width(AI_SETTINGS_DROPDOWN_WIDTH);
+            dropdown.set_menu_width(AI_SETTINGS_DROPDOWN_WIDTH, ctx);
+            dropdown.set_menu_max_height(AI_SETTINGS_DROPDOWN_MAX_HEIGHT, ctx);
+            dropdown.add_items(items, ctx);
+            dropdown.set_selected_by_action(
+                WarpAgentPageAction::SetAiCommandSearchDebounceMs(current),
+                ctx,
+            );
+            dropdown
+        });
+        Self { dropdown }
+    }
+}
+
+impl SettingsWidget for AiCommandSearchDebounceWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "# ai command search delay debounce wait typing requests cost latency"
+    }
+
+    fn render(
+        &self,
+        view: &Self::View,
+        appearance: &Appearance,
+        app: &AppContext,
+    ) -> Box<dyn Element> {
+        let is_enabled = AISettings::as_ref(app).is_ai_command_search_enabled(app);
+        render_dropdown_item(
+            appearance,
+            "AI Command Search delay",
+            Some(
+                "How long to wait after you stop typing before asking for suggestions. \
+                 Shorter feels faster; longer sends fewer requests.",
+            ),
+            None,
+            LocalOnlyIconState::for_setting(
+                AiCommandSearchDebounceMs::storage_key(),
+                AiCommandSearchDebounceMs::sync_to_cloud(),
+                &mut view.local_only_icon_tooltip_states.borrow_mut(),
+                app,
+            ),
+            (!is_enabled).then(|| appearance.theme().disabled_ui_text_color()),
+            &self.dropdown,
+        )
+    }
+}
