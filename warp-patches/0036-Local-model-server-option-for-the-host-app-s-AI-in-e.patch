+#[derive(Clone, Copy)]
+enum HostAiLocalKind {
+    Model,
+    Server,
+}
+
+const HOST_AI_LOCAL_SERVER_DEFAULT: &str = "http://127.0.0.1:1234/v1";
+
+/// A local OpenAI-compatible model server (LM Studio etc.) instead of OpenRouter.
+struct HostAiLocalWidget {
+    kind: HostAiLocalKind,
+    editor: ViewHandle<EditorView>,
+}
+
+impl HostAiLocalWidget {
+    fn new(kind: HostAiLocalKind, ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let settings = HostAiSettings::as_ref(ctx);
+        let (text, placeholder) = match kind {
+            HostAiLocalKind::Model => (settings.local_model.clone(), "none (use OpenRouter)"),
+            HostAiLocalKind::Server => {
+                (settings.local_server.clone(), HOST_AI_LOCAL_SERVER_DEFAULT)
+            }
+        };
+        let editor = host_settings_editor(&text, placeholder, ctx);
+        ctx.subscribe_to_view(&editor, move |_, editor, event, ctx| {
+            if !matches!(event, EditorEvent::Blurred | EditorEvent::Enter) {
+                return;
+            }
+            let mut value = editor.as_ref(ctx).buffer_text(ctx).trim().to_owned();
+            if matches!(kind, HostAiLocalKind::Server)
+                && !(value.starts_with("http://") || value.starts_with("https://"))
+            {
+                value = HOST_AI_LOCAL_SERVER_DEFAULT.to_owned();
+                editor.update(ctx, |editor, ctx| editor.set_buffer_text(&value, ctx));
+            }
+            HostAiSettings::handle(ctx).update(ctx, |settings, ctx| match kind {
+                HostAiLocalKind::Model => {
+                    report_if_error!(settings.local_model.set_value(value, ctx))
+                }
+                HostAiLocalKind::Server => {
+                    report_if_error!(settings.local_server.set_value(value, ctx))
+                }
+            });
+            ctx.notify();
+        });
+        Self { kind, editor }
+    }
+}
+
+impl SettingsWidget for HostAiLocalWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        match self.kind {
+            HostAiLocalKind::Model => "ai provider local model lm studio ollama offline privacy",
+            HostAiLocalKind::Server => "ai provider local model server url lm studio ollama",
+        }
+    }
+
+    fn should_render(&self, app: &AppContext) -> bool {
+        match self.kind {
+            HostAiLocalKind::Model => true,
+            HostAiLocalKind::Server => !HostAiSettings::as_ref(app).local_model.is_empty(),
+        }
+    }
+
+    fn render(&self, _view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let (label, description) = match self.kind {
+            HostAiLocalKind::Model => (
+                "Local model",
+                "Model id on a local server such as LM Studio (e.g. qwen/qwen3.8-27b). When set, \
+                 #, Next Command and Prompt Suggestions use it instead of OpenRouter, in one \
+                 stage, and nothing leaves this machine. Empty: OpenRouter.",
+            ),
+            HostAiLocalKind::Server => (
+                "Local server",
+                "The server's OpenAI-compatible API (LM Studio: http://127.0.0.1:1234/v1).",
+            ),
+        };
+        let input = appearance
+            .ui_builder()
+            .text_input(self.editor.clone())
+            .with_style(UiComponentStyles {
+                padding: Some(Coords { top: 10., bottom: 10., left: 16., right: 16. }),
+                background: Some(appearance.theme().surface_2().into()),
+                ..Default::default()
+            })
+            .build()
+            .finish();
+        render_host_setting_column(label, description, input, appearance, app)
+    }
+}
+
