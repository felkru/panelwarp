@@ -257,6 +253,17 @@ impl Input {
         }
     }
 
+    /// Re-parses and re-decorates the input even if its text hasn't changed, for when the
+    /// session's known commands changed (e.g. external commands finished loading) and the
+    /// cached parse may have marked valid commands as errors.
+    pub fn redecorate_input(&mut self, ctx: &mut ViewContext<Self>) {
+        self.last_parsed_tokens = None;
+        self.run_input_background_jobs(
+            InputBackgroundJobOptions::default().with_command_decoration(),
+            ctx,
+        );
+    }
+
     /// Applies error underlining and/or syntax highlighting as appropriate,
     /// using the result of the last parse operation.
     fn apply_decorations(&mut self, ctx: &mut ViewContext<Self>) {
