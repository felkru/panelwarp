+/// How long to keep trying to reattach to the shell after the connection drops, e.g. when the
+/// browser closes its sockets on a network change (sleep, Wi-Fi switch). The host keeps the shell
+/// running meanwhile.
+const MAX_RECONNECT_ATTEMPTS: u32 = 200;
+
+type BoxedSink = Pin<Box<dyn futures::Sink<Message, Error = websocket::Error> + Send>>;
+
+/// A message for the PTY host, rebuilt for every send attempt so it can be retried on a new
+/// connection.
+enum Outgoing {
+    Binary(Vec<u8>),
+    Text(String),
+}
+
+impl Outgoing {
+    fn to_message(&self) -> Message {
+        match self {
+            Self::Binary(bytes) => Message::new_binary(bytes.clone()),
+            Self::Text(text) => Message::new_text(text.clone()),
+        }
+    }
+}
+
+/// Control messages the PTY host sends as text frames.
+#[derive(Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum HostControl {
+    /// The id to reattach to this shell with after the connection drops.
+    Session(String),
+    /// The shell exited; there is nothing to reattach to.
+    Exited(i32),
+}
+
 pub(super) struct EventLoop {
     terminal_model: Arc<FairMutex<TerminalModel>>,
     parser: Processor,
     event_loop_rx: Receiver<EventLoopMessage>,
     channel_event_listener: ChannelEventListener,
+    /// The host's id for this shell, once it has sent one.
+    session_id: Option<String>,
+    shell_exited: bool,
+    reconnect_attempts: u32,
+    /// Hands the writer task the sink of a new connection after a reconnect.
+    sink_tx: Sender<BoxedSink>,
+    sink_rx: Receiver<BoxedSink>,
+    /// Whether the current connection is open. A browser WebSocket silently drops what's sent
+    /// after it closes, so the writer holds messages while this is false.
+    connected: Arc<AtomicBool>,
+    writer_started: bool,
 }
 
 impl EventLoop {
@@ -81,11 +132,19 @@ impl EventLoop {
         websocket_receiver: Receiver<EventLoopMessage>,
         channel_event_listener: ChannelEventListener,
     ) -> Self {
