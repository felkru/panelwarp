         Self {
             terminal_model,
             parser: Processor::default(),
             event_loop_rx: websocket_receiver,
             channel_event_listener,
+            session_id: None,
+            shell_exited: false,
+            reconnect_attempts: 0,
+            sink_tx,
+            sink_rx,
+            connected: Arc::new(AtomicBool::new(false)),
+            writer_started: false,
