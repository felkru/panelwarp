-                        EventLoopMessage::Shutdown | EventLoopMessage::ChildExited => {}
+                        EventLoopMessage::Shutdown | EventLoopMessage::ChildExited => continue,
+                    };
+
+                    // Hold the message while disconnected, switch to the newest connection, then
+                    // send; if the send fails, wait for the event loop to reconnect.
+                    if !connected.load(Ordering::SeqCst) {
+                        match new_sinks.recv().await {
+                            Ok(newer) => sink = newer,
+                            Err(_) => return,
+                        }
+                    }
+                    while let Ok(newer) = new_sinks.try_recv() {
+                        sink = newer;
+                    }
+                    while sink.send(outgoing.to_message()).await.is_err() {
+                        match new_sinks.recv().await {
+                            Ok(newer) => sink = newer,
+                            Err(_) => return,
+                        }
                     }
                 }
             })
             .detach();
     }
 
+    fn on_host_control(&mut self, text: &str) {
+        match serde_json::from_str::<HostControl>(text) {
+            Ok(HostControl::Session(id)) => self.session_id = Some(id),
+            Ok(HostControl::Exited(code)) => {
+                log::info!("Remote shell exited with code {code}");
+                self.shell_exited = true;
+            }
+            Err(_) => report_error!("Received unknown text message from the PTY host"),
+        }
+    }
+
+    fn on_connection_closed(&mut self, ctx: &mut ModelContext<Self>) {
+        self.connected.store(false, Ordering::SeqCst);
+        if self.shell_exited || self.session_id.is_none() {
+            return;
+        }
+        log::warn!("Connection to the PTY host closed; reattaching to the shell");
+        self.schedule_reconnect(ctx);
+    }
+
+    fn schedule_reconnect(&mut self, ctx: &mut ModelContext<Self>) {
+        if self.reconnect_attempts >= MAX_RECONNECT_ATTEMPTS {
+            report_error!("Gave up reattaching to the remote shell");
+            return;
+        }
+        self.reconnect_attempts += 1;
+        // Back off from a quick first retry to one every 5 s.
+        let delay = Duration::from_millis(250 * 2u64.pow(self.reconnect_attempts.min(5) - 1))
+            .min(Duration::from_secs(5));
+        ctx.spawn(Timer::after(delay), |me, _, ctx| me.reconnect(ctx));
+    }
+
+    fn reconnect(&mut self, ctx: &mut ModelContext<Self>) {
+        let Some(session_id) = self.session_id.clone() else {
+            return;
+        };
+        let endpoint = create_session_endpoint();
+        let separator = if endpoint.contains('?') { '&' } else { '?' };
+        let url = format!("{endpoint}{separator}session={session_id}");
+        ctx.spawn(
+            WebSocket::connect(url, None /* protocols */),
+            Self::on_ws_connection,
+        );
+    }
+
     /// Writes the ZSH init shell script to the "PTY", mimicking how we send the init shell script
     /// when there is a local pty:
     /// <https://github.com/warpdotdev/warp-internal/blob/747da2df83f2caa97e781ce284ceb226fb97a66c/app/src/terminal/local_tty/unix.rs#L338-L347>.
@@ -232,7 +356,12 @@ impl EventLoop {
         let connection = match connection {
             Ok(connection) => connection,
             Err(e) => {
-                report_error!(e.context("Failed to construct websocket connection"));
+                if self.session_id.is_some() && !self.shell_exited {
+                    // Still reattaching (e.g. the network is back but not the host yet).
+                    self.schedule_reconnect(ctx);
+                } else {
+                    report_error!(e.context("Failed to construct websocket connection"));
+                }
                 return;
             }
         };
