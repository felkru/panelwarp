+/// The environment that turns on the bootstrap's SSH wrapper, from the Warpify settings.
+#[derive(Clone, Copy)]
+struct SshWrapperEnv {
+    enabled: bool,
+    reuse_control_master: bool,
+}
+
+impl SshWrapperEnv {
+    fn from_settings(ctx: &ModelContext<EventLoop>) -> Self {
+        let enabled = *WarpifySettings::as_ref(ctx)
+            .enable_ssh_warpification
+            .value();
+        Self {
+            enabled,
+            reuse_control_master: enabled
+                && *SshSettings::as_ref(ctx)
+                    .reuse_existing_control_master
+                    .value(),
+        }
+    }
+
+    fn vars(self) -> [(&'static str, &'static str); 4] {
+        let flag = |on: bool| if on { "1" } else { "0" };
+        [
+            ("WARP_IS_LOCAL_SHELL_SESSION", "1"),
+            ("WARP_USE_SSH_WRAPPER", flag(self.enabled)),
+            ("WARP_SSH_REUSE_CONTROL_MASTER", flag(self.reuse_control_master)),
+            ("SSH_SOCKET_DIR", "$HOME/.ssh"),
+        ]
+    }
+}
+
 pub(super) enum EventLoopEvent {
     /// The PTY host saw what looks like a password prompt in the running command.
     PossiblePasswordPrompt,
@@ -241,6 +276,7 @@ impl EventLoop {
         self.writer_started = true;
 
         let is_honor_ps1_enabled = *SessionSettings::as_ref(ctx).honor_ps1;
+        let ssh_wrapper = SshWrapperEnv::from_settings(ctx);
 
         let terminal_model_for_init = self.terminal_model.clone();
         let receiver = self.event_loop_rx.clone();
@@ -253,7 +289,8 @@ impl EventLoop {
                 let shell_type = remote_shell_type();
                 Self::wait_until_shell_reads_input(&shell_output).await;
                 if let Err(e) =
-                    Self::write_env_vars(&mut sink, shell_type, is_honor_ps1_enabled).await
+                    Self::write_env_vars(&mut sink, shell_type, is_honor_ps1_enabled, ssh_wrapper)
+                        .await
                 {
                     report_error!(e.context("Failed to write env vars to pty"));
                 }
@@ -457,15 +494,25 @@ impl EventLoop {
         sink: &mut impl Sink,
         shell_type: ShellType,
         is_honor_ps1_enabled: bool,
+        ssh_wrapper: SshWrapperEnv,
     ) -> anyhow::Result<()> {
         // This starts the init line typed into the shell; the leading space keeps it out of the
         // user's history file (HIST_IGNORE_SPACE / HISTCONTROL=ignorespace), like the bootstrap.
         let honor_ps1 = is_honor_ps1_enabled as u8;
-        let honor_ps1_env_var = match shell_type {
+        let mut env_vars = match shell_type {
             ShellType::Fish => format!(" set -gx WARP_HONOR_PS1 {honor_ps1};"),
             _ => format!(r#" WARP_HONOR_PS1="{honor_ps1}";"#),
         };
-        sink.send(Message::new_binary(honor_ps1_env_var.as_bytes().to_vec()))
+        // The host's shell runs on the user's machine, so it's a local session like a desktop
+        // Warp shell: these make the bootstrap wrap `ssh` and Warpify the remote shell, as the
+        // desktop PTY's environment does (local_tty/unix.rs).
+        for (name, value) in ssh_wrapper.vars() {
+            env_vars.push_str(&match shell_type {
+                ShellType::Fish => format!(" set -gx {name} {value};"),
+                _ => format!(r#" export {name}="{value}";"#),
+            });
+        }
+        sink.send(Message::new_binary(env_vars.as_bytes().to_vec()))
             .await?;
 
         Ok(())
