+/// Whether the host has its settings or keybindings file open in an editor. If so, it asks the
+/// user to close the file and then reopens settings at `page` (a [`SettingsSection`] slug), so
+/// settings always open showing what the file says. Returns true if the host took over.
+///
+/// [`SettingsSection`]: crate::settings_view::SettingsSection
+pub fn settings_pane_held_by_host(page: Option<&str>) -> bool {
+    host_has_function("warpPanelSettingsFileOpen")
+        && matches!(ffi::settings_file_open(), Ok(true))
+        && ffi::request_settings(page.unwrap_or_default()).is_ok()
+}
+
 /// Whether the host page defines `window[name]` as a function, for UI that only works with
 /// that hook.
 pub fn host_has_function(name: &str) -> bool {
@@ -949,4 +966,72 @@ pub mod host_settings {
     }
 
     impl warpui::SingletonEntity for Reload {}
+
+    /// `window.warpPanelCloseSettings()` closes the settings tab, which the host calls when it
+    /// opens the settings file, and `window.warpPanelOpenSettingsPage(slug)` reopens it once the
+    /// file is closed.
+    pub struct PaneHooks;
+
+    enum PaneRequest {
+        Close,
+        Open(String),
+    }
+
+    impl PaneHooks {
+        pub fn new(ctx: &mut warpui::ModelContext<Self>) -> Self {
+            let (tx, rx) = futures::channel::mpsc::unbounded::<PaneRequest>();
+            let close_tx = tx.clone();
+            let close = Closure::<dyn Fn()>::new(move || {
+                let _ = close_tx.unbounded_send(PaneRequest::Close);
+            });
+            let open = Closure::<dyn Fn(Option<String>)>::new(move |slug: Option<String>| {
+                let _ = tx.unbounded_send(PaneRequest::Open(slug.unwrap_or_default()));
+            });
+            let window = gloo::utils::window();
+            let _ = js_sys::Reflect::set(&window, &"warpPanelCloseSettings".into(), close.as_ref());
+            let _ = js_sys::Reflect::set(
+                &window,
+                &"warpPanelOpenSettingsPage".into(),
+                open.as_ref(),
+            );
+            // The hooks live for the lifetime of the page.
+            close.forget();
+            open.forget();
+            ctx.spawn_stream_local(
+                rx,
+                |_, request, ctx| {
+                    let workspaces = crate::workspace::WorkspaceRegistry::as_ref(ctx).all_workspaces(ctx);
+                    match request {
+                        PaneRequest::Close => {
+                            for (_, workspace) in workspaces {
+                                workspace.update(ctx, |workspace, ctx| {
+                                    workspace.close_settings_pane(ctx)
+                                });
+                            }
+                        }
+                        PaneRequest::Open(slug) => {
+                            let active = ctx.windows().active_window();
+                            let workspace = workspaces
+                                .iter()
+                                .find(|(window_id, _)| Some(*window_id) == active)
+                                .or(workspaces.first());
+                            if let Some((_, workspace)) = workspace {
+                                workspace.update(ctx, |workspace, ctx| {
+                                    workspace.open_settings_pane_from_host(&slug, ctx)
+                                });
+                            }
+                        }
+                    }
+                },
+                |_, _| {},
+            );
+            Self
+        }
+    }
+
+    impl warpui::Entity for PaneHooks {
+        type Event = ();
+    }
+
+    impl warpui::SingletonEntity for PaneHooks {}
 }
