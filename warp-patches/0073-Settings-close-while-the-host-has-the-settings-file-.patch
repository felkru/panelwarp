+    /// Closes this window's settings tab, for the host when it opens the settings file.
+    #[cfg(target_family = "wasm")]
+    pub fn close_settings_pane(&mut self, ctx: &mut ViewContext<Self>) {
+        let locator = SettingsPaneManager::handle(ctx)
+            .as_ref(ctx)
+            .find_pane(ctx.window_id());
+        if let Some(locator) = locator {
+            self.close_pane(locator.pane_group_id, locator.pane_id, ctx);
+        }
+    }
+
+    /// Opens settings at the page with `slug` (or the default page), for the host after it
+    /// closed the settings file.
