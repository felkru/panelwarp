+/// Command history persisted by the embedding host app (VS Code: a SQLite `commands` table in the
+/// extension's storage, mirroring desktop Warp's), since the web build has no local database.
+/// Rows mirror `persistence::model::Command`; timestamps are RFC 3339, session ids decimal strings.
+#[cfg(feature = "remote_tty")]
+pub mod host_history {
+    use chrono::{DateTime, Local};
+    use serde::{Deserialize, Serialize};
+
+    use crate::persistence::{FinishedCommandMetadata, StartedCommandMetadata};
+    use crate::terminal::history::{PersistedCommand, ShellHost};
+    use crate::terminal::shell::ShellType;
+
+    #[derive(Serialize, Deserialize)]
+    struct Row {
+        #[serde(default)]
+        id: i32,
+        command: String,
+        exit_code: Option<i32>,
+        start_ts: Option<String>,
+        completed_ts: Option<String>,
+        pwd: Option<String>,
+        shell: Option<String>,
+        username: Option<String>,
+        hostname: Option<String>,
+        session_id: Option<String>,
+        git_branch: Option<String>,
+        workflow_command: Option<String>,
+        #[serde(default)]
+        is_agent_executed: bool,
+    }
+
+    #[derive(Serialize)]
+    struct Finished {
+        session_id: String,
+        start_ts: String,
+        completed_ts: String,
+        exit_code: i32,
+    }
+
+    fn parse_ts(ts: Option<String>) -> Option<DateTime<Local>> {
+        ts.and_then(|ts| DateTime::parse_from_rfc3339(&ts).ok())
+            .map(|ts| ts.with_timezone(&Local))
+    }
+
+    /// Persisted commands from the host, newest first (like desktop's sqlite load).
+    pub fn load() -> Vec<PersistedCommand> {
+        let Some(json) = super::ffi::command_history().ok().flatten() else {
+            return Vec::new();
+        };
+        let rows: Vec<Row> = serde_json::from_str(&json).unwrap_or_default();
+        rows.into_iter()
+            .map(|row| PersistedCommand {
+                id: row.id,
+                command: row.command,
+                exit_code: row.exit_code.map(Into::into),
+                start_ts: parse_ts(row.start_ts),
+                completed_ts: parse_ts(row.completed_ts),
+                pwd: row.pwd,
+                shell_host: match (row.shell, row.username, row.hostname) {
+                    (Some(shell), Some(user), Some(hostname)) => ShellType::from_name(&shell)
+                        .map(|shell_type| ShellHost {
+                            shell_type,
+                            user,
+                            hostname,
+                        }),
+                    _ => None,
+                },
+                session_id: row
+                    .session_id
+                    .and_then(|id| id.parse::<u64>().ok())
+                    .map(Into::into),
+                git_branch: row.git_branch,
+                workflow_id: None,
+                workflow_command: row.workflow_command,
+                is_agent_executed: row.is_agent_executed,
+            })
+            .collect()
+    }
+
+    pub fn record_started(metadata: &StartedCommandMetadata) {
+        let row = Row {
+            id: 0,
+            command: metadata.command.clone(),
+            exit_code: None,
+            start_ts: metadata.start_ts.map(|ts| ts.to_rfc3339()),
+            completed_ts: None,
+            pwd: metadata.pwd.clone(),
+            shell: metadata.shell.clone(),
+            username: metadata.username.clone(),
+            hostname: metadata.hostname.clone(),
+            session_id: metadata.session_id.map(|id| id.as_u64().to_string()),
+            git_branch: metadata.git_branch.clone(),
+            workflow_command: metadata.workflow_command.clone(),
+            is_agent_executed: metadata.is_agent_executed,
+        };
+        if let Ok(json) = serde_json::to_string(&row) {
+            let _ = super::ffi::record_command("started", &json);
+        }
+    }
+
+    pub fn record_finished(metadata: &FinishedCommandMetadata) {
+        let finished = Finished {
+            session_id: metadata.session_id.as_u64().to_string(),
+            start_ts: metadata.start_ts.to_rfc3339(),
+            completed_ts: metadata.completed_ts.to_rfc3339(),
+            exit_code: metadata.exit_code.value(),
+        };
+        if let Ok(json) = serde_json::to_string(&finished) {
+            let _ = super::ffi::record_command("finished", &json);
+        }
+    }
+}
