+#[derive(serde::Deserialize)]
+struct HostGeneratedCommand {
+    command: String,
+    description: String,
+    #[serde(default)]
+    parameters: Vec<HostCommandParameter>,
+}
+
+#[derive(serde::Deserialize)]
+struct HostCommandParameter {
+    id: String,
+    description: String,
+}
+
+/// Generates commands for AI Command Search (`#`) via the embedding host app's
+/// `window.warpPanelGenerateCommands(prompt, contextJson)`, which resolves to a JSON array of
+/// `{command, description, parameters: [{id, description}]}` or rejects with an error code
+/// (`bad_prompt`, `rate_limited`, `provider_error`, or anything else for a generic error).
+pub async fn generate_commands_in_host(
+    prompt: String,
+    ai_execution_context: Option<crate::ai_assistant::execution_context::WarpAiExecutionContext>,
+) -> Result<
+    Vec<crate::ai_assistant::AIGeneratedCommand>,
+    crate::ai_assistant::GenerateCommandsFromNaturalLanguageError,
+> {
+    use crate::ai_assistant::{AIGeneratedCommand, GenerateCommandsFromNaturalLanguageError as Error};
+
+    let context_json = ai_execution_context.and_then(|context| context.to_json_string());
+    let promise = ffi::generate_commands(&prompt, context_json).map_err(|_| Error::Other)?;
+    let result = wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .map_err(|err| match err.as_string().as_deref() {
+            Some("bad_prompt") => Error::BadPrompt,
+            Some("rate_limited") => Error::RateLimited,
+            Some("provider_error") => Error::AiProviderError,
+            _ => Error::Other,
+        })?;
+    let json = result.as_string().ok_or(Error::Other)?;
+    let commands: Vec<HostGeneratedCommand> =
+        serde_json::from_str(&json).map_err(|_| Error::Other)?;
+    Ok(commands
+        .into_iter()
+        .map(|c| {
+            AIGeneratedCommand::new(
+                c.command,
+                c.description,
+                c.parameters.into_iter().map(|p| (p.id, p.description)).collect(),
+            )
+        })
+        .collect())
+}
+
+/// Asks the embedding host app (e.g. the VS Code panel) to open its settings file, since the web
+/// build keeps settings in localStorage rather than a file. Returns false if the host doesn't
+/// provide `window.warpPanelOpenSettingsFile`.
+pub fn open_settings_file_in_host() -> bool {
+    ffi::open_settings_file_in_host().is_ok()
+}
