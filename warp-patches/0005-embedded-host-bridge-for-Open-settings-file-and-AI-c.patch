+impl AIGeneratedCommand {
+    /// Builds a command generated outside Warp's server (e.g. by an embedding host app's own AI
+    /// provider). `parameters` are `(id, description)` pairs matching `{{id}}` in `command`.
+    pub fn new(command: String, description: String, parameters: Vec<(String, String)>) -> Self {
+        Self {
+            command,
+            description,
+            parameters: parameters
+                .into_iter()
+                .map(|(id, description)| AIGeneratedCommandParameter { id, description })
+                .collect(),
+        }
+    }
+}
