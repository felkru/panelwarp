+/// Prompt suggestions for a CLI coding agent through the host's fast model; only available with
+/// private routing on.
+#[derive(Default)]
+struct HostAiPromptSuggestionsWidget {
+    toggle: SwitchStateHandle,
+}
+
+impl SettingsWidget for HostAiPromptSuggestionsWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "ai a.i. prompt suggestions cli coding agent claude code privacy"
+    }
+
+    fn render(&self, view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let settings = HostAiSettings::as_ref(app);
+        let private_routing = *settings.private_routing;
+        let toggle = render_ai_setting_toggle::<HostAiPromptSuggestions>(
+            "Prompt Suggestions",
+            WarpAgentPageAction::ToggleHostAiPromptSuggestions,
+            *settings.prompt_suggestions && private_routing,
+            private_routing,
+            self.toggle.clone(),
+            &view.local_only_icon_tooltip_states,
+            app,
+        );
+        let description = if private_routing {
+            "When a command finishes, the fast model may suggest a task for your CLI coding agent, \
+             shown above the input. Accepting it starts the agent with that prompt. Sends the \
+             command and its output."
+        } else {
+            "Only available with private routing on, since it sends command output."
+        };
+        let column = Flex::column()
+            .with_spacing(4.)
+            .with_child(toggle)
+            .with_child(
+                Text::new(description, appearance.ui_font_family(), CONTENT_FONT_SIZE)
+                    .with_color(styles::description_font_color(true, app).into())
+                    .finish(),
+            )
+            .finish();
+        host_setting_row(column)
+    }
+}
+
+/// The command that starts the CLI coding agent for accepted prompt suggestions.
+struct HostAiPromptSuggestionsAgentWidget {
+    editor: ViewHandle<EditorView>,
+}
+
+impl HostAiPromptSuggestionsAgentWidget {
+    fn new(ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let text = HostAiSettings::as_ref(ctx).prompt_suggestions_agent.clone();
+        let editor = host_settings_editor(&text, "claude", ctx);
+        ctx.subscribe_to_view(&editor, move |_, editor, event, ctx| {
+            if !matches!(event, EditorEvent::Blurred | EditorEvent::Enter) {
+                return;
+            }
+            let mut agent = editor.as_ref(ctx).buffer_text(ctx).trim().to_owned();
+            if agent.is_empty() {
+                agent = "claude".to_owned();
+                editor.update(ctx, |editor, ctx| editor.set_buffer_text(&agent, ctx));
+            }
+            HostAiSettings::handle(ctx).update(ctx, |settings, ctx| {
+                report_if_error!(settings.prompt_suggestions_agent.set_value(agent, ctx))
+            });
+        });
+        Self { editor }
+    }
+}
+
+impl SettingsWidget for HostAiPromptSuggestionsAgentWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "ai a.i. prompt suggestions cli coding agent command claude code codex gemini"
+    }
+
+    fn should_render(&self, app: &AppContext) -> bool {
+        let settings = HostAiSettings::as_ref(app);
+        *settings.prompt_suggestions && *settings.private_routing
+    }
+
+    fn render(&self, _view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let input = appearance
+            .ui_builder()
+            .text_input(self.editor.clone())
+            .with_style(UiComponentStyles {
+                padding: Some(Coords { top: 10., bottom: 10., left: 16., right: 16. }),
+                background: Some(appearance.theme().surface_2().into()),
+                ..Default::default()
+            })
+            .build()
+            .finish();
+        render_host_setting_column(
+            "CLI agent command",
+            "Starts the agent for an accepted suggestion, with the prompt as its last argument, \
+             e.g. claude, codex or gemini -i.",
+            input,
+            appearance,
+            app,
+        )
+    }
+}
+
