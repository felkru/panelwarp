+/// Suggests a prompt for a CLI coding agent via the embedding host app's
+/// `window.warpPanelPromptSuggestion(requestJson)`, which gets Warp's prompt suggestion request
+/// as JSON and resolves to the prompt, or to null/empty when it has none.
+pub async fn prompt_suggestion_in_host(request_json: String) -> Result<Option<String>, String> {
+    let promise = ffi::prompt_suggestion(&request_json).map_err(|err| format!("{err:?}"))?;
+    let result = wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .map_err(|err| err.as_string().unwrap_or_else(|| format!("{err:?}")))?;
+    Ok(result
+        .as_string()
+        .map(|prompt| prompt.trim().to_owned())
+        .filter(|prompt| !prompt.is_empty()))
+}
