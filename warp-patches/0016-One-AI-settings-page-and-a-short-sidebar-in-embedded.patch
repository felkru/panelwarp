+/// What a planned-but-not-yet-implemented settings row says on hover.
+pub const NOT_IMPLEMENTED_TOOLTIP: &str = "Not implemented yet";
+
+/// A greyed-out, switched-off settings row for a feature embedded (`remote_tty`) builds plan to
+/// add but don't have yet. Hovering it says it isn't implemented.
+pub(super) struct PlannedFeatureWidget<V> {
+    label: &'static str,
+    description: &'static str,
+    search_terms: &'static str,
+    switch_state: SwitchStateHandle,
+    mouse_state: MouseStateHandle,
+    view: PhantomData<fn() -> V>,
+}
+
+impl<V> PlannedFeatureWidget<V> {
+    pub(super) fn new(
+        label: &'static str,
+        description: &'static str,
+        search_terms: &'static str,
+    ) -> Self {
+        Self {
+            label,
+            description,
+            search_terms,
+            switch_state: Default::default(),
+            mouse_state: Default::default(),
+            view: PhantomData,
+        }
+    }
+}
+
+impl<V: View> SettingsWidget for PlannedFeatureWidget<V> {
+    type View = V;
+
+    fn widget_id(&self) -> &'static str {
+        self.label
+    }
+
+    fn search_terms(&self) -> &str {
+        self.search_terms
+    }
+
+    fn render(&self, _view: &V, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let label = render_body_item_label::<SettingsAction>(
+            self.label.to_owned(),
+            Some(styles::header_font_color(false, app)),
+            None,
+            LocalOnlyIconState::Hidden,
+            ToggleState::Disabled,
+            appearance,
+        );
+        let switch = render_ai_feature_switch(self.switch_state.clone(), false, false, (), app);
+        let description = self.description;
+        Hoverable::new(self.mouse_state.clone(), move |mouse_state| {
+            let row = Flex::column()
+                .with_child(build_toggle_element(label, switch, appearance, None))
+                .with_child(render_ai_setting_description(description, false, app))
+                .finish();
+            let mut stack = Stack::new().with_child(row);
+            if mouse_state.is_hovered() {
+                stack.add_positioned_child(
+                    appearance
+                        .ui_builder()
+                        .tool_tip(NOT_IMPLEMENTED_TOOLTIP.to_owned())
+                        .build()
+                        .finish(),
+                    OffsetPositioning::offset_from_parent(
+                        vec2f(0., -3.),
+                        ParentOffsetBounds::Unbounded,
+                        ParentAnchor::TopLeft,
+                        ChildAnchor::BottomLeft,
+                    ),
+                );
+            }
+            stack.finish()
+        })
+        .finish()
+    }
+}
