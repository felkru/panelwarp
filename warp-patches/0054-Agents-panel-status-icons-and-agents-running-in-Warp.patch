+impl WarpPane {
+    /// Whether this pane runs the host's conversation `agent`/`id`.
+    fn matches(&self, agent: &str, id: &str) -> bool {
+        host_agent_name(self.agent) == Some(agent) && self.session_id.as_deref() == Some(id)
+    }
