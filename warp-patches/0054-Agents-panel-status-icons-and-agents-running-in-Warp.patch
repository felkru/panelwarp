-fn warp_panes(app: &AppContext) -> HashMap<(&'static str, &str), WarpPane> {
+fn cli_agent_from_host_name(agent: &str) -> Option<CLIAgent> {
+    match agent {
+        "claude" => Some(CLIAgent::Claude),
+        "codex" => Some(CLIAgent::Codex),
+        "gemini" => Some(CLIAgent::Gemini),
+        _ => None,
+    }
+}
+
+/// The CLI agents running in Warp's panes, oldest pane first.
+fn warp_panes(app: &AppContext) -> Vec<WarpPane> {
     let notifications = AgentNotificationsModel::as_ref(app).notifications();
-    CLIAgentSessionsModel::as_ref(app)
+    let mut panes: Vec<WarpPane> = CLIAgentSessionsModel::as_ref(app)
         .sessions()
-        .filter_map(|(terminal_view_id, session)| {
-            let agent = host_agent_name(session.agent)?;
