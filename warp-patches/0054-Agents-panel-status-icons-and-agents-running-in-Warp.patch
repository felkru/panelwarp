-            Some((
-                (agent, id),
-                WarpPane {
-                    terminal_view_id,
-                    unread: notifications.has_unread_for_terminal_view(terminal_view_id),
-                },
-            ))
+        .filter(|(_, session)| !matches!(session.agent, CLIAgent::Unknown))
+        .map(|(terminal_view_id, session)| {
+            let context = &session.session_context;
+            WarpPane {
+                terminal_view_id,
+                agent: session.agent,
+                session_id: context.session_id.clone(),
+                status: (session.listener.is_some() && session.supports_rich_status())
+                    .then(|| session.status.to_conversation_status()),
+                unread: notifications.has_unread_for_terminal_view(terminal_view_id),
+                title: context
+                    .query
+                    .clone()
+                    .filter(|query| !query.is_empty())
+                    .unwrap_or_else(|| format!("{} in a Warp tab", session.agent.display_name())),
+                cwd: context.cwd.clone(),
+            }
         })
-        .collect()
+        .collect();
+    panes.sort_by_key(|pane| pane.terminal_view_id);
+    panes
+}
+
+/// The status a row shows: the pane's when the conversation runs in a Warp pane, else the host's.
+fn row_status(
+    conversation: &HostAgentConversation,
+    pane: Option<&WarpPane>,
+) -> Option<ConversationStatus> {
+    if let Some(pane) = pane {
+        return pane.status.clone();
+    }
+    match conversation.status.as_deref() {
+        Some("working") => Some(ConversationStatus::InProgress),
+        Some("done") => Some(ConversationStatus::Success),
+        _ => None,
+    }
 }
 
