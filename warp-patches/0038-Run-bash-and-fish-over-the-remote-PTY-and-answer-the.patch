+/// The shell the PTY host runs, from the `shell` parameter of the session endpoint (e.g.
+/// `...create?token=SECRET&shell=bash`); zsh when it's missing or unknown.
+pub(crate) fn remote_shell_type() -> ShellType {
+    shell_type_from_endpoint(&create_session_endpoint())
+}
+
+fn shell_type_from_endpoint(endpoint: &str) -> ShellType {
+    endpoint
+        .split_once('?')
+        .into_iter()
+        .flat_map(|(_, query)| query.split('&'))
+        .find_map(|param| param.strip_prefix("shell="))
+        .and_then(ShellType::from_name)
+        .filter(|shell| *shell != ShellType::PowerShell)
+        .unwrap_or(ShellType::Zsh)
+}
