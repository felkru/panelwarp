@@ -0,0 +1,29 @@
+use super::*;
+
+#[test]
+fn shell_type_from_endpoint_reads_the_shell_parameter() {
+    let endpoint = "ws://127.0.0.1:1/create?token=abc&shell=bash";
+    assert_eq!(shell_type_from_endpoint(endpoint), ShellType::Bash);
+    assert_eq!(
+        shell_type_from_endpoint("ws://127.0.0.1:1/create?shell=fish&token=abc"),
+        ShellType::Fish
+    );
+    assert_eq!(
+        shell_type_from_endpoint("ws://127.0.0.1:1/create?shell=zsh"),
+        ShellType::Zsh
+    );
+}
+
+#[test]
+fn shell_type_from_endpoint_defaults_to_zsh() {
+    assert_eq!(shell_type_from_endpoint(CREATE_SESSION_ENDPOINT), ShellType::Zsh);
+    assert_eq!(
+        shell_type_from_endpoint("ws://127.0.0.1:1/create?token=abc&shell=nu"),
+        ShellType::Zsh
+    );
+    // The host app can't run PowerShell through the remote PTY.
+    assert_eq!(
+        shell_type_from_endpoint("ws://127.0.0.1:1/create?shell=pwsh"),
+        ShellType::Zsh
+    );
+}
