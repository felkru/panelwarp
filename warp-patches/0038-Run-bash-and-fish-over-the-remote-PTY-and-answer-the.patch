-    /// Writes the ZSH init shell script to the "PTY", mimicking how we send the init shell script
+    /// Waits until the shell has started: its first output, then no output for
+    /// [`SHELL_START_QUIET`] (at most [`SHELL_START_TIMEOUT`]). Until the shell's line editor
+    /// reads input, the terminal holds a typed line in its 1024-byte canonical buffer
+    /// (MAX_CANON on macOS) and drops the rest; the init line is longer. fish, which takes a
+    /// moment to start, lost it.
+    async fn wait_until_shell_reads_input(shell_output: &Receiver<()>) {
+        use futures_util::future::{select, Either};
+        let first = shell_output.recv();
+        futures_util::pin_mut!(first);
+        if let Either::Right(_) = select(first, Timer::after(SHELL_START_TIMEOUT)).await {
+            return;
+        }
+        loop {
+            let next = shell_output.recv();
+            futures_util::pin_mut!(next);
+            match select(next, Timer::after(SHELL_START_QUIET)).await {
+                Either::Left((Ok(()), _)) => continue,
+                _ => return,
+            }
+        }
+    }
