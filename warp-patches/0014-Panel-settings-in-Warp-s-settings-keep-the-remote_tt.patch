+}
+
+impl SettingsWidget for HostAiPrivateRoutingWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "ai provider openrouter private routing privacy zero data retention zdr training"
+    }
+
+    fn render(&self, view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let toggle = render_ai_setting_toggle::<HostAiPrivateRouting>(
