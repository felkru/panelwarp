+#[derive(Clone, Copy)]
+enum HostAiModelKind {
+    Fast,
+    Expanded,
+}
+
+/// OpenRouter model ids for the two AI Command Search stages (embedded builds).
+struct HostAiModelWidget {
+    kind: HostAiModelKind,
+    editor: ViewHandle<EditorView>,
+}
+
+impl HostAiModelWidget {
+    fn new(kind: HostAiModelKind, ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let settings = HostAiSettings::as_ref(ctx);
+        let (text, placeholder) = match kind {
+            HostAiModelKind::Fast => (settings.fast_model.clone(), "deepseek/deepseek-v4.1-flash"),
+            HostAiModelKind::Expanded => (settings.expanded_model.clone(), "none (fast suggestions only)"),
+        };
+        let editor = host_settings_editor(&text, placeholder, ctx);
+        ctx.subscribe_to_view(&editor, move |_, editor, event, ctx| {
+            if !matches!(event, EditorEvent::Blurred | EditorEvent::Enter) {
+                return;
+            }
+            let mut model = editor.as_ref(ctx).buffer_text(ctx).trim().to_owned();
+            if matches!(kind, HostAiModelKind::Fast) && model.is_empty() {
+                model = "deepseek/deepseek-v4.1-flash".to_owned();
+                editor.update(ctx, |editor, ctx| editor.set_buffer_text(&model, ctx));
+            }
+            HostAiSettings::handle(ctx).update(ctx, |settings, ctx| match kind {
+                HostAiModelKind::Fast => report_if_error!(settings.fast_model.set_value(model, ctx)),
+                HostAiModelKind::Expanded => {
+                    report_if_error!(settings.expanded_model.set_value(model, ctx))
+                }
+            });
+        });
+        Self { kind, editor }
+    }
+}
+
+impl SettingsWidget for HostAiModelWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        match self.kind {
+            HostAiModelKind::Fast => "ai provider openrouter fast model deepseek command search #",
+            HostAiModelKind::Expanded => {
+                "ai provider openrouter expanded model claude sonnet command search #"
+            }
+        }
+    }
+
+    fn render(&self, _view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let (label, description) = match self.kind {
+            HostAiModelKind::Fast => (
+                "Fast model",
+                "OpenRouter model for the first 1-2 # suggestions. Pick a low-latency one.",
+            ),
+            HostAiModelKind::Expanded => (
+                "Expanded model",
+                "OpenRouter model that adds different # suggestions once you pause typing. \
+                 Empty: fast suggestions only.",
+            ),
+        };
+        let input = appearance
+            .ui_builder()
+            .text_input(self.editor.clone())
+            .with_style(UiComponentStyles {
+                padding: Some(Coords { top: 10., bottom: 10., left: 16., right: 16. }),
+                background: Some(appearance.theme().surface_2().into()),
+                ..Default::default()
+            })
+            .build()
+            .finish();
+        render_host_setting_column(label, description, input, appearance, app)
+    }
+}
