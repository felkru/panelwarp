+/// Asks the embedding host app to confirm an action with a modal dialog
+/// (`window.warpPanelConfirm(message, detail, confirmLabel)`, resolving to a boolean). Resolves
+/// to false if the host doesn't provide it or the user cancels.
+pub async fn confirm_in_host(message: &str, detail: &str, confirm_label: &str) -> bool {
+    let Ok(promise) = ffi::confirm(message, detail, confirm_label) else {
+        return false;
+    };
+    wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .ok()
+        .and_then(|value| value.as_bool())
+        .unwrap_or(false)
+}
