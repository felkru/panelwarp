+/// Reasoning effort for the expanded stage.
+struct HostAiEffortWidget {
+    dropdown: ViewHandle<Dropdown<WarpAgentPageAction>>,
+}
+
+impl HostAiEffortWidget {
+    fn new(ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let current = HostAiSettings::as_ref(ctx).expanded_effort.clone();
+        let dropdown = ctx.add_typed_action_view(|ctx| {
+            let mut dropdown = Dropdown::new(ctx);
+            dropdown.set_top_bar_max_width(AI_SETTINGS_DROPDOWN_WIDTH);
+            dropdown.set_menu_width(AI_SETTINGS_DROPDOWN_WIDTH, ctx);
+            dropdown.set_menu_max_height(AI_SETTINGS_DROPDOWN_MAX_HEIGHT, ctx);
+            dropdown.add_items(
+                HOST_AI_EFFORT_CHOICES
+                    .into_iter()
+                    .map(|effort| {
+                        DropdownItem::new(
+                            effort.to_owned(),
+                            WarpAgentPageAction::SetHostAiExpandedEffort(effort.to_owned()),
+                        )
+                    })
+                    .collect(),
+                ctx,
+            );
+            dropdown.set_selected_by_action(WarpAgentPageAction::SetHostAiExpandedEffort(current), ctx);
+            dropdown
+        });
+        Self { dropdown }
+    }
+}
+
+impl SettingsWidget for HostAiEffortWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "ai provider openrouter expanded model reasoning effort thinking command search #"
+    }
+
+    fn render(&self, view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        render_dropdown_item(
