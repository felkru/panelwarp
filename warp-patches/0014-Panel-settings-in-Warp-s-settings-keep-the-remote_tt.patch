+            .with_child(
+                Text::new(
+                    "Only use OpenRouter hosts that don't train on or retain your requests (for \
+                     Sonnet 5.5: Amazon Bedrock and Google Vertex).",
+                    appearance.ui_font_family(),
+                    CONTENT_FONT_SIZE,
+                )
+                .with_color(styles::description_font_color(true, app).into())
+                .finish(),
+            )
+            .finish()
+    }
+}
+
+const HOST_AI_RECENT_COMMANDS_CHOICES: [u32; 5] = [0, 1, 3, 5, 10];
+
+/// How many recent commands go along with `#` requests (only with private routing on).
+struct HostAiRecentCommandsWidget {
+    dropdown: ViewHandle<Dropdown<WarpAgentPageAction>>,
+}
+
+impl HostAiRecentCommandsWidget {
+    fn new(ctx: &mut ViewContext<WarpAgentPageView>) -> Self {
+        let current = *HostAiSettings::as_ref(ctx).recent_commands_in_context;
+        let dropdown = ctx.add_typed_action_view(|ctx| {
+            let mut dropdown = Dropdown::new(ctx);
+            dropdown.set_top_bar_max_width(AI_SETTINGS_DROPDOWN_WIDTH);
+            dropdown.set_menu_width(AI_SETTINGS_DROPDOWN_WIDTH, ctx);
+            dropdown.set_menu_max_height(AI_SETTINGS_DROPDOWN_MAX_HEIGHT, ctx);
+            dropdown.add_items(
+                HOST_AI_RECENT_COMMANDS_CHOICES
+                    .into_iter()
+                    .map(|count| {
+                        DropdownItem::new(
+                            if count == 0 { "None".to_owned() } else { count.to_string() },
+                            WarpAgentPageAction::SetHostAiRecentCommands(count),
+                        )
+                    })
+                    .collect(),
+                ctx,
+            );
+            dropdown.set_selected_by_action(WarpAgentPageAction::SetHostAiRecentCommands(current), ctx);
+            dropdown
+        });
+        Self { dropdown }
+    }
+}
+
+impl SettingsWidget for HostAiRecentCommandsWidget {
+    type View = WarpAgentPageView;
+
+    fn search_terms(&self) -> &str {
+        "ai provider recent commands history context command search # privacy"
+    }
+
+    fn render(&self, view: &Self::View, appearance: &Appearance, app: &AppContext) -> Box<dyn Element> {
+        let private_routing = *HostAiSettings::as_ref(app).private_routing;
